    "%@ ist für heute als Nein notiert.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دُوِّن %@ اليوم على أنه لا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আজকের জন্য না লেখা হলো।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is noted as a no for today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ queda anotado como no para hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est noté non pour aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ आज के लिए ना दर्ज हुआ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dicatat tidak untuk hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è segnato come no per oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は今日「いいえ」と記録しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 오늘 아니요로 기록했습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ficou anotado como não para hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ записан на сегодня как «нет»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bugün için hayır olarak yazıldı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ آج کے لیے نہیں درج ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ được ghi là không cho hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已记为今天的“否”。"
          }
        }
      }
    },
    "%@ ist kein Ja/Nein-Habit — dort gibt es nur das Abhaken.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ليست عادة نعم/لا — يمكن إنهاؤها فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ হ্যাঁ/না হ্যাবিট নয় — শুধু টিক দেওয়া যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a yes/no habit — it only supports checking off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no es un hábito de sí/no; solo se puede marcar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas une habitude oui/non — elle ne se coche que."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ हाँ/ना आदत नहीं है — इसे केवल पूरा किया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bukan habit ya/tidak — hanya bisa dicentang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è un'abitudine sì/no — si può solo spuntare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ははい/いいえのハビットではなく、チェックのみ可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 예/아니요 해빗이 아니라 체크만 가능합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não é um hábito de sim/não — só dá para marcar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — не привычка да/нет, её можно только отмечать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir evet/hayır alışkanlığı değil — yalnızca işaretlenebilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ہاں/نہیں عادت نہیں — صرف مکمل کی جا سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không phải thói quen có/không — chỉ có thể đánh dấu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@不是是/否习惯——只能打卡完成。"
          }
        }
      }
    },

    "Nicht bei iCloud angemeldet — die Daten bleiben auf diesem Gerät.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تسجيل الدخول إلى iCloud — تبقى البيانات على هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-এ সাইন ইন করা নেই — ডেটা এই ডিভাইসেই থাকবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed in to iCloud — the data stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin sesión iniciada en iCloud: los datos se quedan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non connecté à iCloud — les données restent sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud में साइन इन नहीं — डेटा इसी डिवाइस पर रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum masuk ke iCloud — datanya tetap di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso a iCloud: i dati restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudにサインインしていません。データはこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인되어 있지 않아요 — 데이터는 이 기기에 남아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem login no iCloud — os dados ficam neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в iCloud не выполнен — данные остаются на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud’a giriş yapılmadı — veriler bu cihazda kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud میں سائن اِن نہیں — ڈیٹا اسی ڈیوائس پر رہے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đăng nhập iCloud — dữ liệu ở lại trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未登录 iCloud——数据留在这台设备上。"
          }
        }
      }
    },

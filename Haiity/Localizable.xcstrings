    "Optional: deine Daten in einem privaten Repo deines GitHub-Accounts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري: بياناتك في Repo خاص داخل حسابك على GitHub."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক: আপনার ডেটা আপনার GitHub অ্যাকাউন্টের একটি প্রাইভেট Repo-তে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: your data in a private repo in your GitHub account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: tus datos en un repo privado de tu cuenta de GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : tes données dans un repo privé de ton compte GitHub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक: आपका डेटा आपके GitHub अकाउंट के एक प्राइवेट Repo में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional: datamu di repo privat pada akun GitHub-mu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo: i tuoi dati in un repo privato del tuo account GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：データをあなたのGitHubアカウントのプライベートRepoに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: 내 GitHub 계정의 비공개 Repo에 데이터를 보관해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: seus dados em um repo privado da sua conta do GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По желанию: твои данные в приватном Repo твоего аккаунта GitHub."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı: verilerin GitHub hesabındaki özel bir repoda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختیاری: آپ کا ڈیٹا آپ کے GitHub اکاؤنٹ کے ایک نجی Repo میں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn: dữ liệu của bạn trong một repo riêng tư thuộc tài khoản GitHub của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：把你的数据放进你 GitHub 账户下的一个私有 Repo。"
          }
        }
      }
    },
    "Optional: deine Daten in einem privaten Repo deines GitHub-Accounts. Ein Tipp, ein Code, fertig.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري: بياناتك في Repo خاص داخل حسابك على GitHub. ضغطة واحدة، رمز واحد، وانتهى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক: আপনার ডেটা আপনার GitHub অ্যাকাউন্টের একটি প্রাইভেট Repo-তে। এক ট্যাপ, এক কোড, ব্যস।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: your data in a private repo in your GitHub account. One tap, one code, done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: tus datos en un repo privado de tu cuenta de GitHub. Un toque, un código, listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : tes données dans un repo privé de ton compte GitHub. Un tap, un code, c’est fait."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक: आपका डेटा आपके GitHub अकाउंट के एक प्राइवेट Repo में। एक टैप, एक कोड, हो गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional: datamu di repo privat pada akun GitHub-mu. Sekali ketuk, satu kode, selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo: i tuoi dati in un repo privato del tuo account GitHub. Un tocco, un codice, fatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：データをあなたのGitHubアカウントのプライベートRepoに。タップひとつ、コードひとつで完了。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: 내 GitHub 계정의 비공개 Repo에 데이터를 보관해요. 한 번 탭하고 코드만 넣으면 끝."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: seus dados em um repo privado da sua conta do GitHub. Um toque, um código, pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По желанию: твои данные в приватном Repo твоего аккаунта GitHub. Одно нажатие, один код — готово."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı: verilerin GitHub hesabındaki özel bir repoda. Bir dokunuş, bir kod, tamam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختیاری: آپ کا ڈیٹا آپ کے GitHub اکاؤنٹ کے ایک نجی Repo میں۔ ایک ٹیپ، ایک کوڈ، ہو گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn: dữ liệu của bạn trong một repo riêng tư thuộc tài khoản GitHub của bạn. Một chạm, một mã, xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：把你的数据放进你 GitHub 账户下的一个私有 Repo。轻点一下，输入一个代码，搞定。"
          }
        }
      }
    },

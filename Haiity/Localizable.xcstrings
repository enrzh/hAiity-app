    "Heute stand alles auf dem Plan — und alles ist drin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء كان في خطة اليوم — وكله أُنجز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ পরিকল্পনায় যা ছিল — সবই হয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything was on today's plan — and everything is in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy todo estaba en el plan, y todo está dentro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout était au programme aujourd'hui — et tout y est."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज योजना में जो था — सब हो गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ada di rencana hari ini — dan semua masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi era tutto in programma — e c'è tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予定は全部こなしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 계획했던 것 전부 — 다 해냈어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje tudo estava no plano — e tudo entrou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня всё было по плану — и всё на месте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün her şey plandaydı — hepsi yerinde."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج منصوبے میں جو تھا — سب ہو گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay mọi thứ trong kế hoạch — và đều hoàn thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天计划里的一切——全都做到了。"
          }
        }
      }
    },

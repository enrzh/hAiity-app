    "Nach einer Lücke zählt das nächste Quadrat, nicht die Erklärung dafür.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الفجوة، المهم هو المربع التالي، لا تفسير الفجوة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাঁকের পরে গুরুত্বপূর্ণ হলো পরের ঘরটি, ব্যাখ্যা নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a gap, what counts is the next square, not the explanation for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de un hueco cuenta el siguiente cuadrado, no la explicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après un trou, c’est la case suivante qui compte, pas l’explication."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली दिन के बाद अगला वर्ग मायने रखता है, उसकी सफ़ाई नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah bolong, yang penting kotak berikutnya, bukan penjelasannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo un vuoto conta il quadratino successivo, non la spiegazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いたあとに効くのは次のマスであって、その言い訳ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 칸 다음에 중요한 건 다음 칸이지, 그 이유가 아닙니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de uma falha, o que conta é o próximo quadradinho, não a explicação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После пропуска важен следующий квадратик, а не объяснение к нему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir boşluktan sonra önemli olan sonraki karedir, açıklaması değil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خالی دن کے بعد اگلا خانہ اہم ہے، اس کی وضاحت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau một ô trống, điều đáng kể là ô vuông kế tiếp, không phải lời giải thích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断了之后，重要的是下一格，而不是解释。"
          }
        }
      }
    },

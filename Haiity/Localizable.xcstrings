    "Beschreibe kurz, was du gemacht hast und was dann geschah — je genauer, desto eher lässt sich der Fehler nachstellen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صف باختصار ما فعلته وما حدث بعده — كلما كان الوصف أدق، صار تكرار المشكلة أسهل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংক্ষেপে লিখুন আপনি কী করেছিলেন আর তারপর কী হয়েছিল — যত নির্দিষ্ট, সমস্যা তত সহজে ধরা যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe briefly what you did and what happened next — the more precise, the easier the problem is to reproduce."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe brevemente qué hiciste y qué ocurrió después — cuanto más preciso, más fácil será reproducir el fallo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris brièvement ce que tu as fait et ce qui s’est passé ensuite — plus c’est précis, plus le problème est facile à reproduire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संक्षेप में लिखें कि आपने क्या किया और फिर क्या हुआ — जितना सटीक, समस्या दोहराना उतना आसान।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan singkat apa yang kamu lakukan dan apa yang terjadi — makin detail, makin mudah masalahnya ditiru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi in breve che cosa hai fatto e che cosa è successo dopo — più sei preciso, più è facile riprodurre il problema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何をしたときに何が起きたかを短く書いてください。具体的なほど再現しやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 하다가 어떤 일이 생겼는지 짧게 적어 주세요. 구체적일수록 문제를 재현하기 쉬워요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva rapidamente o que você fez e o que aconteceu depois — quanto mais preciso, mais fácil reproduzir o problema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите коротко, что вы делали и что произошло потом — чем точнее, тем легче воспроизвести ошибку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne yaptığını ve sonra ne olduğunu kısaca anlat — ne kadar net olursa, hatayı yeniden oluşturmak o kadar kolay."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مختصر لکھیں کہ آپ نے کیا کیا اور پھر کیا ہوا — جتنا واضح ہوگا، مسئلہ دہرانا اتنا آسان ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả ngắn gọn bạn đã làm gì và chuyện gì xảy ra sau đó — càng cụ thể thì lỗi càng dễ tái hiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简单描述你做了什么、随后发生了什么——越具体，问题越容易复现。"
          }
        }
      }
    },
    "Beschreibung verwerfen und nicht mehr fragen?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تجاهل الوصف وعدم السؤال مرة أخرى؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্ণনা বাতিল করে আর জিজ্ঞাসা না করা হবে?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard the description and stop asking?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar la descripción y no volver a preguntar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer la description et ne plus demander ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विवरण हटाएँ और दोबारा न पूछें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang deskripsi dan jangan tanya lagi?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare la descrizione e non chiedere più?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した内容を破棄して、今後は尋ねないようにしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성한 설명을 버리고 다시 묻지 않을까요?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar a descrição e não perguntar mais?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить описание и больше не спрашивать?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıklama silinsin ve bir daha sorulmasın mı?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تفصیل ضائع کر کے دوبارہ نہ پوچھا جائے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ phần mô tả và không hỏi nữa?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃已写的描述，并不再询问？"
          }
        }
      }
    },

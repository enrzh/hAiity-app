    "Habits im Kalender? Das ist Pro.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العادات في التقويم؟ هذا في Pro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারে অভ্যাস? সেটা Pro-তে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Habits in Calendar? That’s Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Hábitos en el calendario? Eso es Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des habitudes dans le calendrier ? C’est Pro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर में आदतें? वह Pro में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebiasaan di Kalender? Itu Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abitudini nel calendario? Quello è Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーに習慣を？それはProです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에 습관을? 그건 Pro예요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hábitos no calendário? Isso é Pro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привычки в календаре? Это Pro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimde alışkanlıklar mı? O Pro’da."
          }
        },
        "ur": {

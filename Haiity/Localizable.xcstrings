    "GitHub hat die Anfrage abgelehnt (HTTP %lld). Bitte später erneut versuchen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض GitHub الطلب (HTTP %lld). حاول لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub অনুরোধটি প্রত্যাখ্যান করেছে (HTTP %lld)। পরে আবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub rejected the request (HTTP %lld). Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub rechazó la solicitud (HTTP %lld). Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a refusé la demande (HTTP %lld). Réessaie plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ने अनुरोध अस्वीकार कर दिया (HTTP %lld)। बाद में फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub menolak permintaan ini (HTTP %lld). Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ha rifiutato la richiesta (HTTP %lld). Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubがリクエストを拒否しました（HTTP %lld）。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub이 요청을 거부했어요 (HTTP %lld). 잠시 후 다시 시도해 주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub recusou a solicitação (HTTP %lld). Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub отклонил запрос (HTTP %lld). Попробуй позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub isteği reddetti (HTTP %lld). Lütfen daha sonra tekrar dene."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub نے درخواست مسترد کر دی (HTTP %lld)۔ بعد میں دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub đã từ chối yêu cầu (HTTP %lld). Hãy thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 拒绝了这个请求（HTTP %lld）。请稍后再试。"
          }
        }
      }
    },
    "GitHub hat die Anmeldung abgelehnt (%@). Bitte neu starten.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض GitHub تسجيل الدخول (%@). ابدأ من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub সাইন ইন প্রত্যাখ্যান করেছে (%@)। আবার শুরু করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub rejected the sign-in (%@). Please start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub rechazó el inicio de sesión (%@). Empieza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a refusé la connexion (%@). Recommence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ने साइन इन अस्वीकार कर दिया (%@)। कृपया फिर से शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub menolak proses masuk (%@). Silakan mulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ha rifiutato l’accesso (%@). Ricomincia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubがサインインを拒否しました（%@）。最初からやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub이 로그인을 거부했어요 (%@). 다시 시작해 주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub recusou o login (%@). Comece de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub отклонил вход (%@). Начни заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub oturum açmayı reddetti (%@). Lütfen yeniden başla."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",

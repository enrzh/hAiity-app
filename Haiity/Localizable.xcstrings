    "Gesamt-Serie %lld Tage, beste Serie %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السلسلة الإجمالية %lld يومًا، وأفضل سلسلة %lld."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মোট ধারা %lld দিন, সেরা ধারা %lld।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overall streak %lld days, best streak %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Racha total de %lld días, mejor racha %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Série globale de %lld jours, meilleure série %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुल सिलसिला %lld दिन, सर्वश्रेष्ठ सिलसिला %lld।"
          }
        },
        "id": {

    "Monate ohne diesen Tag werden übersprungen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُتخطى الأشهر التي لا تحتوي هذا اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব মাসে এই তারিখ নেই, সেগুলো বাদ যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Months without that day are skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los meses que no tienen ese día se saltan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mois sans ce jour sont sautés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन महीनों में यह तारीख़ नहीं होती, वे छोड़ दिए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulan yang tidak punya tanggal itu akan dilewati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I mesi senza quel giorno vengono saltati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日がない月はスキップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 날짜가 없는 달은 건너뛰어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meses sem esse dia são pulados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяцы без такого числа пропускаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günü içermeyen aylar atlanır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جن مہینوں میں یہ تاریخ نہیں ہوتی، وہ چھوڑ دیے جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những tháng không có ngày này sẽ được bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有这一天的月份会被跳过。"
          }
        }
      }
    },

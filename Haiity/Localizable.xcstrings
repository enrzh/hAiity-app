    "%@: %lld Tage im letzten Jahr, aktuelle Serie %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld يومًا في السنة الأخيرة، والسلسلة الحالية %3$lld."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: গত এক বছরে %2$lld দিন, বর্তমান স্ট্রিক %3$lld।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$lld Tage im letzten Jahr, aktuelle Serie %3$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld days in the last year, current streak %3$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld días en el último año, racha actual: %3$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : %2$lld jours sur la dernière année, série actuelle : %3$lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: पिछले साल में %2$lld दिन, मौजूदा स्ट्रीक %3$lld।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld hari dalam setahun terakhir, streak saat ini %3$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld giorni nell’ultimo anno, serie attuale: %3$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：過去1年で%2$lld日、現在の連続記録は%3$lld日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 지난 1년간 %2$lld일, 현재 연속 %3$lld일."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld dias no último ano, sequência atual: %3$lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld дн. за последний год, текущая серия — %3$lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: son bir yılda %2$lld gün, güncel seri %3$lld."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: پچھلے سال میں %2$lld دن، موجودہ سلسلہ %3$lld۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld ngày trong năm qua, chuỗi hiện tại %3$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：过去一年 %2$lld 天，当前连续 %3$lld 天。"
          }
        }
      }
    },
    "%lld Gewohnheit(en) heute noch offen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld عادة (عادات) لا تزال متبقية اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ এখনও %lldটি অভ্যাস বাকি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld habit(s) still open today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hábito(s) pendiente(s) hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld habitude(s) encore à faire aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज %lld आदत(ें) अभी बाकी हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kebiasaan masih tersisa hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld abitudine/i ancora da fare oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日まだ%lld件の習慣が残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 아직 %lld개의 습관이 남았어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hábito(s) ainda pendente(s) hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привычек на сегодня осталось: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün hâlâ %lld alışkanlık bekliyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج ابھی %lld عادت(یں) باقی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay còn %lld thói quen chưa xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还有 %lld 个习惯未完成。"
          }
        }
      }
    },

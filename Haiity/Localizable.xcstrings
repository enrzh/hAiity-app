    "Nennt die laufende Serie eines Habits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بسلسلة العادة الجارية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি হ্যাবিটের চলতি স্ট্রিক জানায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you a habit's current streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice la racha actual de un hábito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne la série en cours d'une habitude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी आदत का चालू सिलसिला बताता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi tahu streak berjalan sebuah habit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice la serie in corso di un'abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハビットの現在の連続記録を教えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해빗의 현재 스트릭을 알려줍니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz a sequência atual de um hábito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Называет текущую серию привычки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alışkanlığın süren serisini söyler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی عادت کا جاری سلسلہ بتاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho biết chuỗi hiện tại của một thói quen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉你某个习惯当前的连击。"
          }
        }
      }
    },

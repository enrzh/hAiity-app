    "„%@“ und die komplette Historie (%lld Check-ins) werden gelöscht. Das lässt sich nicht rückgängig machen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف «%1$@» وكامل سجلّها (%2$lld تسجيل إنجاز). لا يمكن التراجع عن ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” এবং তার সম্পূর্ণ ইতিহাস (%2$lldটি চেক-ইন) মুছে ফেলা হবে। এটি ফেরানো যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "„%1$@“ und die komplette Historie (%2$lld Check-ins) werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” and its entire history (%2$lld check-ins) will be deleted. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán «%1$@» y todo su historial (%2$lld check-ins). Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » et tout son historique (%2$lld check-ins) seront supprimés. C’est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” और उसका पूरा इतिहास (%2$lld चेक-इन) हटा दिया जाएगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” beserta seluruh riwayatnya (%2$lld check-in) akan dihapus. Ini tidak bisa dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e tutta la cronologia (%2$lld check-in) verranno eliminati. L’operazione è irreversibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」と履歴すべて（チェックイン%2$lld回）が削除されます。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”과(와) 전체 기록(체크인 %2$lld회)이 삭제돼요. 되돌릴 수 없어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e todo o histórico (%2$lld check-ins) serão excluídos. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» и вся история (%2$lld чек-инов) будут удалены. Это нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ve tüm geçmişi (%2$lld check-in) silinecek. Bu geri alınamaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” اور اس کی پوری تاریخ (%2$lld چیک اِن) حذف ہو جائے گی۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” và toàn bộ lịch sử (%2$lld check-in) sẽ bị xóa. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”及其全部历史记录（%2$lld 次打卡）都会被删除。此操作无法撤销。"
          }
        }
      }
    },

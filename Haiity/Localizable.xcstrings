    "Misch dir eigene Paletten aus einer Grundfarbe, für die App und für einzelne Habits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امزج لوحات ألوانك الخاصة من لون أساسي واحد، للتطبيق ولعادات بعينها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি মূল রং থেকে নিজের প্যালেট বানান — অ্যাপের জন্য এবং আলাদা অভ্যাসের জন্য।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mix your own palettes from a base color, for the app and for individual habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tus propias paletas a partir de un color base, para la app y para hábitos concretos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose tes propres palettes à partir d’une couleur de base, pour l’app et pour certaines habitudes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक आधार रंग से अपने पैलेट बनाएँ — ऐप के लिए और अलग-अलग आदतों के लिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Racik palet sendiri dari satu warna dasar, untuk aplikasi dan untuk kebiasaan tertentu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea le tue tavolozze da un colore base, per l’app e per le singole abitudini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準色ひとつから独自のパレットを作れます。アプリ全体にも、個々の習慣にも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준색 하나로 나만의 팔레트를 만들어 앱 전체에도, 습관 하나하나에도 쓸 수 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte suas próprias paletas a partir de uma cor base, para o app e para hábitos específicos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собирай свои палитры из базового цвета — для приложения и для отдельных привычек."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ana renkten kendi paletlerini karıştır, hem uygulama hem tek tek alışkanlıklar için."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بنیادی رنگ سے اپنے پیلیٹ بنائیں — ایپ کے لیے اور الگ الگ عادات کے لیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pha bảng màu riêng từ một màu nền, cho ứng dụng và cho từng thói quen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用一个基色调出自己的调色板，可用于整个 App，也可用于单个习惯。"
          }
        }
      }
    },

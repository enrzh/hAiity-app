    "Am Ende bleibt die Reihe in Erinnerung, nicht der einzelne Dienstag.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في النهاية يبقى الصف في الذاكرة، لا ذلك الثلاثاء بمفرده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষে মনে থাকে সারিটা, আলাদা কোনো মঙ্গলবার নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the end it is the row you remember, not the individual Tuesday."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al final se recuerda la fila, no el martes suelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin, c’est la rangée qu’on retient, pas le mardi isolé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आख़िर में कतार याद रहती है, कोई एक मंगलवार नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada akhirnya yang diingat adalah barisnya, bukan satu hari Selasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla fine resta in mente la fila, non il singolo martedì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に残るのは列の記憶であって、ある火曜日の記憶ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결국 기억에 남는 건 줄이지, 어느 화요일 하루가 아니에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No fim, o que fica na memória é a fileira, não a terça-feira isolada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В итоге запоминается ряд, а не отдельный вторник."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonunda akılda sıra kalır, tek bir salı günü değil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر میں قطار یاد رہتی ہے، کوئی ایک منگل نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuối cùng thứ đọng lại là cả hàng, chứ không phải riêng ngày thứ Ba nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后留在记忆里的是整整一行，而不是某个星期二。"
          }
        }
      }
    },
    "Am Ende der Woche: wie viele Termine du gehalten hast.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في نهاية الأسبوع: كم موعدًا التزمت به."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সপ্তাহের শেষে: আপনি কতগুলি নির্ধারিত দিন রেখেছেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the end of the week: how many scheduled days you kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al final de la semana: cuántas citas has cumplido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fin de semaine : combien de rendez-vous tu as tenus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताह के अंत में: आपने कितने तय दिन निभाए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di akhir minggu: berapa banyak jadwal yang kamu penuhi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A fine settimana: quanti impegni hai rispettato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週の終わりに：予定をどれだけ守れたか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주말에: 예정된 날을 얼마나 지켰는지."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No fim da semana: quantos compromissos você cumpriu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В конце недели: сколько запланированного вы выполнили."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonunda: kaç planı tuttuğun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہفتے کے آخر میں: آپ نے کتنے طے شدہ دن نبھائے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuối tuần: bạn đã giữ được bao nhiêu lịch hẹn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周结束时：你完成了多少计划。"
          }
        }
      }
    },

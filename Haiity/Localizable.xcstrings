          }
        }
      }
    },
    "Diagnose kopiert.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم نسخ التشخيص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডায়াগনস্টিক কপি হয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics copied."
          }
        },
        "es": {
          "stringUnit": {

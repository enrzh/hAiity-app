    "Jede Zelle von heute ist gefüllt. Morgen wartet die nächste Reihe.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امتلأت كل خلايا اليوم. غدًا ينتظر الصف التالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের প্রতিটি ঘর ভরে গেছে। কাল পরের সারি অপেক্ষায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every cell of today is filled. Tomorrow the next row awaits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada celda de hoy está llena. Mañana espera la siguiente fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque case du jour est remplie. Demain, la rangée suivante attend."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की हर सेल भर गई। कल अगली कतार इंतज़ार में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua sel hari ini terisi. Besok baris berikutnya menunggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni cella di oggi è piena. Domani aspetta la prossima fila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のマスはすべて埋まりました。明日は次の一列。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 칸이 모두 채워졌어요. 내일은 다음 줄이 기다려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada célula de hoje está preenchida. Amanhã espera a próxima fileira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая клетка сегодня закрашена. Завтра ждёт следующий ряд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün her hücresi dolu. Yarın sıradaki satır bekliyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کا ہر خانہ بھر گیا۔ کل اگلی قطار منتظر ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi ô của hôm nay đã đầy. Ngày mai hàng tiếp theo đang chờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的每个格子都填满了。明天下一行在等你。"
          }
        }
      }
    },

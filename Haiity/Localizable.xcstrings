    "Zuletzt abgeglichen um %@. Kein Konto, keine Anmeldung in der App.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر مزامنة في %@. لا حساب ولا تسجيل دخول داخل التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বশেষ সিঙ্ক %@-এ। কোনো অ্যাকাউন্ট নেই, অ্যাপে সাইন ইন নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last synced at %@. No account, no sign-in in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última sincronización a las %@. Sin cuenta, sin iniciar sesión en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière synchronisation à %@. Aucun compte, aucune connexion dans l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आख़िरी सिंक %@ बजे। कोई अकाउंट नहीं, ऐप में कोई साइन-इन नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terakhir disinkronkan pukul %@. Tanpa akun, tanpa masuk di aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima sincronizzazione alle %@. Nessun account, nessun accesso nell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終同期は%@。アカウントもアプリ内のサインインも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 동기화 %@. 계정도, 앱 내 로그인도 없어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Última sincronização às %@. Sem conta, sem login no app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя синхронизация в %@. Ни аккаунта, ни входа в приложении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son eşitleme saat %@. Hesap yok, uygulamada oturum açma yok."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آخری سنک %@ بجے۔ کوئی اکاؤنٹ نہیں، ایپ میں کوئی سائن اِن نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ lần cuối lúc %@. Không tài khoản, không đăng nhập trong ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次同步于 %@。无需账号，也无需在 App 内登录。"
          }
        }
      }
    },

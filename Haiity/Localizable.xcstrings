    "Zwei Minuten zählen im Raster genauso viel wie zwei Stunden.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الشبكة، دقيقتان تساويان ساعتين تمامًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রিডে দুই মিনিট আর দুই ঘণ্টা সমানভাবেই গোনা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the grid, two minutes count exactly as much as two hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la cuadrícula, dos minutos cuentan igual que dos horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la grille, deux minutes comptent autant que deux heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्रिड में दो मिनट भी उतने ही गिने जाते हैं जितने दो घंटे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di kisi, dua menit bernilai sama dengan dua jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella griglia due minuti contano quanto due ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッドでは、二分も二時間も同じ一マスです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리드에서는 2분도 2시간과 똑같이 한 칸입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na grade, dois minutos valem tanto quanto duas horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сетке две минуты значат ровно столько же, сколько два часа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgarada iki dakika, iki saat kadar sayılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گرڈ میں دو منٹ بھی اتنے ہی گنے جاتے ہیں جتنے دو گھنٹے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên lưới, hai phút cũng tính như hai giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在格子里，两分钟和两小时算得一样多。"
          }
        }
      }
    },

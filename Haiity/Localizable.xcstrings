    "Jeden Tag ein anderer kurzer Gedanke aus deinem Raster — ruhig, ohne Druck.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل يوم فكرة قصيرة مختلفة من شبكتك — بهدوء، بلا ضغط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদিন তোমার গ্রিড থেকে আলাদা একটি ছোট ভাবনা — শান্ত, কোনো চাপ নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different short thought from your grid every day — calm, without pressure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día, una breve reflexión distinta de tu cuadrícula: tranquila y sin presión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour, une courte pensée différente tirée de ta grille, calme et sans pression."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन आपके ग्रिड से एक अलग छोटा विचार — शांत, बिना दबाव के।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap hari, satu pemikiran singkat yang berbeda dari grid-mu — tenang, tanpa tekanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno un breve pensiero diverso dalla tua griglia, con calma e senza pressioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日、グリッドから短いひと言を。穏やかに、プレッシャーなしで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 그리드에서 다른 짧은 생각을 전해요. 차분하게, 부담 없이."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dias, um pensamento curto e diferente da tua grelha — tranquilo, sem pressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый день — новая короткая мысль из твоей сетки, спокойно и без давления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün tablonundan farklı, kısa bir düşünce — sakin, baskısız."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر روز آپ کے گرڈ سے ایک مختلف مختصر خیال — پُرسکون، بغیر دباؤ کے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi ngày một suy nghĩ ngắn khác nhau từ lưới của bạn — nhẹ nhàng, không áp lực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天从你的网格中送上一句不同的简短想法——平静，没有压力。"
          }
        }
      }
    },

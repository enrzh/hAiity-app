    },
    "Serien reißen. Danach fängt man an derselben Stelle wieder an.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السلاسل تنقطع. وبعدها يُبدأ من المكان نفسه من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধারা ছিঁড়ে যায়। তারপর সেখান থেকেই আবার শুরু।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaks break. Afterwards you start again from the same place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rachas se rompen. Después se empieza otra vez desde el mismo sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries se cassent. Ensuite, on repart du même endroit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिलसिले टूटते हैं। उसके बाद वहीं से फिर शुरू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentetan bisa putus. Setelah itu kita mulai lagi dari tempat yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serie si spezzano. Poi si ricomincia dallo stesso punto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続記録は途切れます。そのあとは同じ場所からまた始めるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속 기록은 끊깁니다. 그다음엔 같은 자리에서 다시 시작하면 돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sequências quebram. Depois se recomeça do mesmo lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серии обрываются. Потом начинают заново с того же места."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriler kopar. Sonra aynı yerden yeniden başlanır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سلسلے ٹوٹتے ہیں۔ اس کے بعد وہیں سے دوبارہ آغاز ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi sẽ đứt. Sau đó ta bắt đầu lại từ chính chỗ ấy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续会断。断了之后，就从原地重新开始。"
          }
        }
      }
    },

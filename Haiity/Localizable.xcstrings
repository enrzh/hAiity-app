    "%@ Deine Daten sind auf diesem Gerät gespeichert und gehen nicht verloren.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ بياناتك محفوظة على هذا الجهاز ولن تُفقد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আপনার ডেটা এই ডিভাইসে সংরক্ষিত আছে এবং হারাবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Your data is stored on this device and will not be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tus datos están guardados en este dispositivo y no se pierden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tes données sont enregistrées sur cet appareil et ne seront pas perdues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ आपका डेटा इसी डिवाइस पर सहेजा है और खोएगा नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Datamu tersimpan di perangkat ini dan tidak akan hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ I tuoi dati sono salvati su questo dispositivo e non vanno persi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ データはこのデバイスに保存されていて、失われることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 데이터는 이 기기에 저장돼 있고 사라지지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Seus dados estão salvos neste dispositivo e não se perdem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Твои данные сохранены на этом устройстве и не потеряются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Verilerin bu cihazda saklı ve kaybolmayacak."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ آپ کا ڈیٹا اسی ڈیوائس پر محفوظ ہے اور ضائع نہیں ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Dữ liệu của bạn được lưu trên thiết bị này và sẽ không mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 你的数据保存在这台设备上，不会丢失。"
          }
        }
      }
    },

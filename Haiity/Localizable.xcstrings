    "%lld Gewohnheit(en) heute noch offen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld عادة (عادات) لا تزال متبقية اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ এখনও %lldটি অভ্যাস বাকি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld habit(s) still open today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hábito(s) pendiente(s) hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld habitude(s) encore à faire aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज %lld आदत(ें) अभी बाकी हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kebiasaan masih tersisa hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld abitudine/i ancora da fare oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日まだ%lld件の習慣が残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 아직 %lld개의 습관이 남았어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hábito(s) ainda pendente(s) hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привычек на сегодня осталось: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün hâlâ %lld alışkanlık bekliyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج ابھی %lld عادت(یں) باقی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay còn %lld thói quen chưa xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还有 %lld 个习惯未完成。"
          }
        }
      }
    },

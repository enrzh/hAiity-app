          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipingi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "塗る"
          }
        },
        "ko": {
          "stringUnit": {

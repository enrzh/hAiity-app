        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रंग का इस्तेमाल करने वाली हर चीज़ डिफ़ॉल्ट रंग पर लौट आएगी।"
          }
        },
        "id": {
          "stringUnit": {

          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张便条"
          }
        }
      }
    },
    "Eine Reihe aus drei Tagen sieht unscheinbar aus und trägt trotzdem.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صف من ثلاثة أيام يبدو عاديًا، ومع ذلك يحمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিন দিনের সারি দেখতে সামান্য, তবু ভার নেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A row of three days looks unremarkable and carries you anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fila de tres días parece poca cosa y aun así sostiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une rangée de trois jours a l’air de rien et porte quand même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन दिनों की कतार मामूली दिखती है, फिर भी सँभाल लेती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Barisan tiga hari kelihatan biasa saja, tapi tetap menopang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fila di tre giorni sembra poca cosa e regge lo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三日ぶんの列は地味に見えて、それでもちゃんと支えになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사흘짜리 줄은 대수롭지 않아 보여도 충분히 버팀목이 됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma fileira de três dias parece pouca coisa e ainda assim sustenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ряд из трёх дней выглядит незаметно и всё равно держит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç günlük bir sıra göze çarpmaz ama yine de taşır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تین دن کی قطار معمولی لگتی ہے، پھر بھی سہارا دیتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một hàng ba ngày trông chẳng có gì mà vẫn nâng được bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三天的一行看着不起眼，却真的托得住。"
          }
        }
      }
    },
    "Eine Session (langer Druck auf die Karte → „Session starten“) läuft als Live-Aktivität mit. Mit Dauer zeigt sie den Fortschritt gegen den Plan, ohne zählt sie einfach hoch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجلسة (ضغطة مطوّلة على البطاقة ← «بدء الجلسة») تعمل كنشاط مباشر. مع تحديد مدة تعرض التقدم مقارنةً بالخطة، وبدونها تكتفي بعدّ الوقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সেশন (কার্ডে দীর্ঘ চাপ → “সেশন শুরু করো”) লাইভ অ্যাক্টিভিটি হিসেবে চলে। সময়কাল দিলে পরিকল্পনার তুলনায় অগ্রগতি দেখায়, না দিলে শুধু সময় গোনে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session (long-press the card → “Start Session”) runs along as a Live Activity. With a duration it shows progress against the plan; without one it simply counts up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión (mantén pulsada la tarjeta → «Comenzar sesión») se muestra como actividad en vivo. Con duración enseña el progreso frente al plan; sin ella, simplemente cuenta el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session (appui long sur la carte → « Démarrer la session ») s’affiche en activité en direct. Avec une durée, elle montre la progression par rapport au plan ; sans, elle compte simplement le temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेशन (कार्ड पर देर तक दबाओ → “सेशन शुरू करो”) लाइव ऐक्टिविटी के रूप में चलता है। अवधि तय हो तो योजना की तुलना में प्रगति दिखाता है, वरना बस समय गिनता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi (tekan lama kartunya → “Mulai Sesi”) berjalan sebagai Aktivitas Langsung. Dengan durasi, sesi menampilkan kemajuan terhadap rencana; tanpa durasi, sesi hanya menghitung waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione (pressione prolungata sulla scheda → «Avvia sessione») viene mostrata come attività in tempo reale. Con una durata mostra i progressi rispetto al piano; senza, conta semplicemente il tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッション（カードを長押し →「セッションを開始」）はライブアクティビティとして表示されます。所要時間を設定すると計画に対する進み具合を、設定しない場合は経過時間だけを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션(카드를 길게 눌러 → “세션 시작”)은 라이브 활동으로 함께 표시됩니다. 시간을 정하면 계획 대비 진행률을, 정하지 않으면 경과 시간만 보여줍니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão (toque longo no cartão → “Iniciar sessão”) acompanha como Atividade ao Vivo. Com duração, mostra o progresso em relação ao plano; sem ela, apenas conta o tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия (долгое нажатие на карточку → «Начать сессию») отображается как Live Activity. С длительностью она показывает прогресс относительно плана, без — просто отсчитывает время."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir seans (karta uzun bas → “Seansı Başlat”) Canlı Etkinlik olarak sürer. Süre belirlenmişse plana göre ilerlemeyi gösterir, belirlenmemişse yalnızca süreyi sayar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک سیشن (کارڈ پر دیر تک دباؤ ← ”سیشن شروع کرو“) لائیو ایکٹیویٹی کے طور پر چلتا ہے۔ دورانیہ مقرر ہو تو منصوبے کے مقابلے میں پیش رفت دکھاتا ہے، ورنہ بس وقت گنتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phiên (nhấn giữ thẻ → “Bắt đầu phiên”) chạy kèm dưới dạng Hoạt động Trực tiếp. Có thời lượng thì hiển thị tiến độ so với kế hoạch, không có thì chỉ đếm thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按卡片 →“开始计时”即可开始一次计时，它会以实时活动显示。设置时长后显示相对计划的进度，未设置则只是累计时间。"
          }
        }
      }
    },
    "Eine feste Uhrzeit je Habit — stellst du beim Anlegen oder Bearbeiten ein.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت ثابت لكل عادة — تضبطه عند الإنشاء أو التعديل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি অভ্যাসের জন্য নির্দিষ্ট সময় — তৈরি বা সম্পাদনার সময় সেট করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed time per habit — set it when creating or editing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hora fija por hábito: se ajusta al crear o editar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une heure fixe par habitude — à régler à la création ou en la modifiant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर आदत के लिए एक तय समय — बनाते या संपादित करते समय सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu tetap per kebiasaan — atur saat membuat atau mengedit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un orario fisso per abitudine — lo imposti creando o modificando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣ごとの固定時刻 — 作成時または編集時に設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관마다 고정 시간 — 만들거나 편집할 때 설정합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um horário fixo por hábito — defina ao criar ou editar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Своё время для каждой привычки — задаётся при создании или изменении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her alışkanlık için sabit bir saat — oluştururken veya düzenlerken ayarlanır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر عادت کے لیے مقررہ وقت — بناتے یا ترمیم کرتے وقت سیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một giờ cố định cho mỗi thói quen — đặt khi tạo hoặc chỉnh sửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个习惯一个固定时间——在创建或编辑时设置。"
          }
        }
      }
    },
    "Eine halbe Sache ist im Raster immer noch mehr als eine leere Zelle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصف الشيء في الشبكة يظل أكثر من خلية فارغة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অর্ধেক করাও গ্রিডে ফাঁকা ঘরের চেয়ে বেশি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half a thing still beats an empty cell in the grid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo a medias sigue siendo más que una celda vacía en la cuadrícula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chose à moitié faite vaut encore mieux qu’une case vide dans la grille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आधा-अधूरा भी ग्रिड में खाली सेल से ज़्यादा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setengah jadi di kisi tetap lebih dari sel yang kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cosa fatta a metà nella griglia vale sempre più di una cella vuota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分だけでも、グリッドでは空のマスより多いのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반만 해도 그리드에서는 빈 칸보다 낫습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meia coisa feita ainda vale mais do que uma célula vazia na grade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделанное наполовину в сетке всё ещё больше, чем пустая клетка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarım yapılmış bir şey, ızgarada boş bir hücreden yine de fazladır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آدھا کام بھی گرڈ میں خالی خانے سے زیادہ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm được một nửa vẫn hơn một ô trống trên lưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半途而止，在格子里也比空着强。"
          }
        }
      }
    },
    "Einen Habit für heute abhaken.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل إنجاز عادة لليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অভ্যাস আজকের জন্য সম্পন্ন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check off a habit for today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca un hábito como hecho hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocher une habitude pour aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी आदत को आज के लिए पूरा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Centang kebiasaan untuk hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spunta un’abitudine per oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣を今日の分として完了にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관을 오늘 완료로 표시해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar um hábito como feito hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметить привычку на сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alışkanlığı bugün için işaretle."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی عادت کو آج کے لیے مکمل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu một thói quen cho hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给某个习惯打上今天的卡。"
          }
        }
      }
    },
    "Einmal": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرة واحدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1회"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 раз"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 次"
          }
        }
      }
    },
    "Einmal am Tag: wie viel von heute erledigt ist und was noch offen steht. Gezählt wird nur, was heute laut Regel ansteht.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرة في اليوم: كم أُنجز من اليوم وما الذي بقي. ولا يُحتسب إلا ما يحين اليوم بحسب القاعدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিনে একবার: আজ কতটা সম্পন্ন হয়েছে আর কী বাকি আছে। কেবল নিয়ম অনুযায়ী আজ যা নির্ধারিত, তাই গোনা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a day: how much of today is done and what is still open. Only what is due today by the rule is counted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al día: cuánto llevas hecho hoy y qué queda pendiente. Solo cuenta lo que hoy toca según la regla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par jour : ce qui est fait aujourd’hui et ce qui reste à faire. Seul ce qui est dû aujourd’hui selon la règle est compté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन में एक बार: आज कितना पूरा हुआ और क्या बाकी है। सिर्फ़ वही गिना जाता है जो नियम के हिसाब से आज तय है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali sehari: berapa banyak yang selesai hari ini dan apa yang masih tersisa. Yang dihitung hanya yang jatuh tempo hari ini menurut aturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta al giorno: quanto di oggi è fatto e cosa resta da fare. Conta solo ciò che oggi è previsto dalla regola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日1回、今日どれだけ終わったか、何が残っているかを知らせます。数えるのはルール上その日が対象のものだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에 한 번, 오늘 얼마나 했고 무엇이 남았는지 알려줘요. 규칙상 오늘 해당하는 것만 세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por dia: quanto de hoje está feito e o que ainda está pendente. Conta só o que vence hoje segundo a regra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день: сколько из сегодняшнего сделано и что осталось. Считается только то, что запланировано на сегодня по правилу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde bir kez: bugünden ne kadarı tamam, ne kalmış. Yalnızca kurala göre bugün gereken sayılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دن میں ایک بار: آج کتنا مکمل ہوا اور کیا باقی ہے۔ صرف وہی شمار ہوتا ہے جو قاعدے کے مطابق آج مقرر ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi ngày một lần: hôm nay đã xong bao nhiêu và còn lại gì. Chỉ tính những gì đến hạn hôm nay theo quy tắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天一次：今天完成了多少、还剩什么。只统计按规则今天该做的。"
          }
        }
      }
    },
    "Einmal in der Woche: wie viele der fälligen Termine du gehalten hast — und welche Habits zurückliegen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرة في الأسبوع: كم من المواعيد المستحقة التزمت بها — وأي العادات متأخرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সপ্তাহে একবার: নির্ধারিত দিনগুলোর কতগুলো আপনি রেখেছেন — আর কোন অভ্যাসগুলো পিছিয়ে আছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a week: how many of the due occurrences you kept — and which habits are falling behind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez a la semana: cuántas de las citas previstas has cumplido y qué hábitos se están quedando atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par semaine : combien d’échéances tu as tenues — et quelles habitudes sont à la traîne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हफ़्ते में एक बार: तय दिनों में से आपने कितने निभाए — और कौन-सी आदतें पीछे रह रही हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali seminggu: berapa banyak jadwal yang kamu penuhi — dan kebiasaan mana yang tertinggal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta a settimana: quante delle scadenze previste hai rispettato e quali abitudini sono rimaste indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週に1回、予定のうちどれだけ守れたか、どの習慣が遅れているかを知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일주일에 한 번, 예정된 일정 중 몇 개를 지켰는지 — 그리고 어떤 습관이 뒤처지는지 알려줘요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por semana: quantos dos compromissos previstos você cumpriu — e quais hábitos estão atrasados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в неделю: сколько запланированного ты выполнил — и какие привычки отстают."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada bir kez: planlı günlerin kaçını tuttun — ve hangi alışkanlıklar geride kalıyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہفتے میں ایک بار: مقررہ دنوں میں سے آپ نے کتنے نبھائے — اور کون سی عادات پیچھے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi tuần một lần: bạn đã giữ được bao nhiêu lịch hẹn — và thói quen nào đang tụt lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周一次：你按时完成了多少次安排——以及哪些习惯落后了。"
          }
        }
      }
    },
    "Einmal kaufen. Kein Abo, kein Konto, kein Server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشتري مرة واحدة. لا اشتراك ولا حساب ولا خادم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবারই কিনুন। কোনো সাবস্ক্রিপশন নেই, অ্যাকাউন্ট নেই, সার্ভার নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy once. No subscription, no account, no server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compra y ya. Sin suscripción, sin cuenta, sin servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un achat, une seule fois. Pas d’abonnement, pas de compte, pas de serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार ख़रीदें। कोई सदस्यता नहीं, कोई अकाउंट नहीं, कोई सर्वर नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beli sekali. Tanpa langganan, tanpa akun, tanpa server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si compra una volta. Nessun abbonamento, nessun account, nessun server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は一度きり。サブスクリプションも、アカウントも、サーバーもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 구입하면 끝. 구독도, 계정도, 서버도 없어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. Sem assinatura, sem conta, sem servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупаешь один раз. Ни подписки, ни аккаунта, ни сервера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez satın al. Abonelik yok, hesap yok, sunucu yok."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار خریدیں۔ کوئی سبسکرپشن نہیں، کوئی اکاؤنٹ نہیں، کوئی سرور نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần. Không thuê bao, không tài khoản, không máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次买断。没有订阅，没有账号，没有服务器。"
          }
        }
      }
    },

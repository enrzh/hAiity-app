    "Import führt zusammen — kein Check-in geht verloren.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستيراد يدمج البيانات — لا يضيع أي تسجيل إنجاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমপোর্ট ডেটা মিলিয়ে দেয় — কোনো চেক-ইন হারায় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import merges — no check-in gets lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación fusiona: no se pierde ningún check-in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’import fusionne — aucun check-in n’est perdu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयात डेटा को मिला देता है — कोई चेक-इन नहीं खोता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor akan menggabungkan — tidak ada check-in yang hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importazione unisce — nessun check-in va perso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みは統合されます——チェックインが失われることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기는 데이터를 합쳐요 — 체크인은 하나도 사라지지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação mescla — nenhum check-in se perde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт объединяет данные — ни один чек-ин не потеряется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarma verileri birleştirir — hiçbir check-in kaybolmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درآمد ڈیٹا کو یکجا کرتی ہے — کوئی چیک اِن ضائع نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập sẽ hợp nhất dữ liệu — không mất check-in nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入会合并数据——不会丢失任何一次打卡。"
          }
        }
      }
    },
    "Import zusammengeführt.": {

    "Prüft, ob Mitteilungen von hAiity ankommen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق مما إذا كانت إشعارات hAiity تصل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "hAiity-র নোটিফিকেশন আসে কি না তা যাচাই করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether notifications from hAiity arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si llegan las notificaciones de hAiity."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie si les notifications de hAiity arrivent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचता है कि hAiity की सूचनाएँ आती हैं या नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa apakah notifikasi hAiity sampai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se le notifiche di hAiity arrivano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hAiityの通知が届くか確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "hAiity 알림이 도착하는지 확인해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se as notificações do hAiity chegam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет, доходят ли уведомления от hAiity."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "hAiity bildirimlerinin ulaşıp ulaşmadığını kontrol eder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جانچتا ہے کہ hAiity کی اطلاعات آتی ہیں یا نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra xem thông báo của hAiity có đến không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 hAiity 的通知能否送达。"
          }
        }
      }
    },
    "Quoten über 30, 90 und 365 Tage, beste Serie, Gesamtzahl und zwölf Monats-Balken — für jeden Habit einzeln.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسب 30 و90 و365 يومًا، وأفضل سلسلة، والعدد الإجمالي، واثنا عشر عمودًا شهريًا — لكل عادة على حدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৩০, ৯০ ও ৩৬৫ দিনের হার, সেরা স্ট্রিক, মোট সংখ্যা আর বারো মাসের বার — প্রতিটি অভ্যাসের জন্য আলাদা করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates over 30, 90 and 365 days, best streak, total count and twelve monthly bars — for each habit on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porcentajes de 30, 90 y 365 días, mejor racha, total y doce barras mensuales — para cada hábito por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taux sur 30, 90 et 365 jours, meilleure série, total et douze barres mensuelles — pour chaque habitude séparément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "30, 90 और 365 दिनों की दरें, सर्वश्रेष्ठ स्ट्रीक, कुल संख्या और बारह मासिक बार — हर आदत के लिए अलग-अलग।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasio 30, 90, dan 365 hari, rentetan terbaik, jumlah total, dan dua belas batang bulanan — untuk tiap kebiasaan secara terpisah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentuali su 30, 90 e 365 giorni, serie migliore, totale e dodici barre mensili — per ogni abitudine singolarmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日・90日・365日の達成率、最高記録、合計、そして12か月分のバー — 習慣ごとに個別に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일, 90일, 365일 달성률, 최고 기록, 총합, 그리고 열두 달치 막대 — 습관마다 따로."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxas de 30, 90 e 365 dias, melhor sequência, total e doze barras mensais — para cada hábito separadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показатели за 30, 90 и 365 дней, лучшая серия, общее число и двенадцать месячных столбиков — для каждой привычки отдельно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30, 90 ve 365 günlük oranlar, en iyi seri, toplam sayı ve on iki aylık çubuk — her alışkanlık için ayrı ayrı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "30، 90 اور 365 دن کی شرحیں، بہترین سلسلہ، کل تعداد اور بارہ ماہانہ بار — ہر عادت کے لیے الگ الگ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tỉ lệ trong 30, 90 và 365 ngày, chuỗi tốt nhất, tổng số và mười hai cột theo tháng — riêng cho từng thói quen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天、90 天和 365 天的完成率，最佳连续、总次数，以及十二个月度柱状图——每个习惯单独呈现。"
          }
        }
      }
    },

    "Trägt die Termine deiner Habits in einen eigenen hAiity-Kalender ein.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُدرج مواعيد عاداتك في تقويم hAiity خاص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অভ্যাসের সময়সূচি একটি আলাদা hAiity ক্যালেন্ডারে যোগ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds your habits’ schedules to a dedicated hAiity calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los horarios de tus hábitos a un calendario hAiity propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inscrit les rendez-vous de tes habitudes dans un calendrier hAiity dédié."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आदतों के समय एक अलग hAiity कैलेंडर में जोड़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan jadwal kebiasaanmu ke kalender hAiity khusus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisce gli impegni delle tue abitudini in un calendario hAiity dedicato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣の予定を専用のhAiityカレンダーに登録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관 일정을 전용 hAiity 캘린더에 기록합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona os horários dos seus hábitos a um calendário hAiity próprio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вносит расписание твоих привычек в отдельный календарь hAiity."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlıklarının programını özel bir hAiity takvimine işler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی عادات کے اوقات ایک الگ hAiity کیلنڈر میں درج کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lịch trình thói quen của bạn vào một lịch hAiity riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把习惯的日程写入专属的 hAiity 日历。"
          }
        }
      }
    },

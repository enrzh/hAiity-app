    "Benachrichtigungen sind in den iOS-Einstellungen deaktiviert.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات معطّلة في إعدادات iOS."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS সেটিংসে নোটিফিকেশন বন্ধ আছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas en los ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées dans les Réglages iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्स में सूचनाएँ बंद हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi dinonaktifkan di Pengaturan iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate nelle impostazioni di iOS."

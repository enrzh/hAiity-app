    "Unerwartete Antwort von GitHub — bitte erneut versuchen.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استجابة غير متوقّعة من GitHub — حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub থেকে অপ্রত্যাশিত সাড়া — আবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unexpected response from GitHub — please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta inesperada de GitHub: inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse inattendue de GitHub — réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub से अप्रत्याशित जवाब मिला — फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Respons tak terduga dari GitHub — coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposta inattesa da GitHub — riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubから予期しない応答がありました——もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 예상치 못한 응답이 왔어요 — 다시 시도해 주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resposta inesperada do GitHub — tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неожиданный ответ от GitHub — попробуй ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub'dan beklenmeyen bir yanıt geldi — lütfen tekrar dene."

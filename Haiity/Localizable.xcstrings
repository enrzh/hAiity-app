        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گرڈ یاد کر رہا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưới đang gọi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格子来打个招呼"
          }
        }
      }
    },
    "Das Raster merkt sich, was du getan hast, nicht was du dir vorgenommen hast.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحفظ الشبكة ما فعلته، لا ما نويت فعله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রিড মনে রাখে আপনি যা করেছেন, যা ভেবেছিলেন তা নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grid remembers what you did, not what you intended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuadrícula recuerda lo que hiciste, no lo que te propusiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La grille retient ce que tu as fait, pas ce que tu avais prévu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्रिड वही याद रखती है जो आपने किया, वह नहीं जो आपने सोचा था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisi mengingat apa yang kamu lakukan, bukan apa yang kamu niatkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La griglia ricorda quello che hai fatto, non quello che avevi in mente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッドが覚えているのは、やったことであって、やろうと思ったことではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리드는 한 일을 기억하지, 하려던 일을 기억하지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A grade guarda o que você fez, não o que você planejou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетка запоминает то, что ты сделал, а не то, что задумал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgara ne yaptığını hatırlar, ne planladığını değil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گرڈ وہ یاد رکھتا ہے جو آپ نے کیا، وہ نہیں جو آپ نے سوچا تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưới nhớ những gì bạn đã làm, không phải những gì bạn định làm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格子记住的是你做过的事，不是你打算做的事。"
          }
        }
      }
    },

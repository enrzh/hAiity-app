    "Erinnert abends einmal an alle noch offenen Habits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكّرك مرة واحدة مساءً بكل العادات المتبقية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সন্ধ্যায় একবার মনে করিয়ে দেয় কোন অভ্যাসগুলো এখনও বাকি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds you once in the evening about every habit still open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te recuerda una vez por la noche todos los hábitos que siguen pendientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te rappelle une fois le soir toutes les habitudes encore à faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शाम को एक बार उन सभी आदतों की याद दिलाता है जो अभी बाकी हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengingatkanmu sekali di malam hari tentang semua kebiasaan yang masih tersisa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti ricorda una volta la sera tutte le abitudini ancora da fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜に一度、まだ残っている習慣をまとめて知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저녁에 한 번, 아직 남은 습관을 모아서 알려줘요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembra você uma vez à noite de todos os hábitos ainda pendentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз вечером напоминает обо всех невыполненных привычках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşam bir kez, hâlâ bekleyen tüm alışkanlıkları hatırlatır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شام میں ایک بار اُن تمام عادات کی یاد دہانی کراتا ہے جو ابھی باقی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc bạn một lần vào buổi tối về tất cả thói quen còn chưa xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晚上提醒你一次，把还没完成的习惯都列出来。"
          }
        }
      }
    },

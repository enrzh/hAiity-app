    "Mehr als drei Habits? Das ist Pro.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكثر من ثلاث عادات؟ هذا في Pro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিনটির বেশি অভ্যাস? সেটা Pro-তে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than three habits? That’s Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Más de tres hábitos? Eso es Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de trois habitudes ? C’est Pro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन से ज़्यादा आदतें? वह Pro में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih dari tiga kebiasaan? Itu Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più di tre abitudini? Quello è Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣を3つより多く？それはProです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관을 셋보다 많이? 그건 Pro예요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais de três hábitos? Isso é Pro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше трёх привычек? Это Pro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üçten fazla alışkanlık mı? O Pro’da."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تین سے زیادہ عادات؟ وہ Pro میں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hơn ba thói quen? Đó là Pro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想要超过三个习惯？那是 Pro。"
          }
        }
      }
    },
    "Mehr schließen": {
      "localizations": {
        "ar": {
          "stringUnit": {

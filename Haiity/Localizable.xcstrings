    "„%@“ und die komplette Historie (%lld Check-ins) werden gelöscht. Das lässt sich nicht rückgängig machen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف «%1$@» وكامل سجلّها (%2$lld تسجيل إنجاز). لا يمكن التراجع عن ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” এবং তার সম্পূর্ণ ইতিহাস (%2$lldটি চেক-ইন) মুছে ফেলা হবে। এটি ফেরানো যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "„%1$@“ und die komplette Historie (%2$lld Check-ins) werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” and its entire history (%2$lld check-ins) will be deleted. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán «%1$@» y todo su historial (%2$lld check-ins). Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » et tout son historique (%2$lld check-ins) seront supprimés. C’est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” और उसका पूरा इतिहास (%2$lld चेक-इन) हटा दिया जाएगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” beserta seluruh riwayatnya (%2$lld check-in) akan dihapus. Ini tidak bisa dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e tutta la cronologia (%2$lld check-in) verranno eliminati. L’operazione è irreversibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」と履歴すべて（チェックイン%2$lld回）が削除されます。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”과(와) 전체 기록(체크인 %2$lld회)이 삭제돼요. 되돌릴 수 없어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e todo o histórico (%2$lld check-ins) serão excluídos. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» и вся история (%2$lld чек-инов) будут удалены. Это нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ve tüm geçmişi (%2$lld check-in) silinecek. Bu geri alınamaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” اور اس کی پوری تاریخ (%2$lld چیک اِن) حذف ہو جائے گی۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” và toàn bộ lịch sử (%2$lld check-in) sẽ bị xóa. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”及其全部历史记录（%2$lld 次打卡）都会被删除。此操作无法撤销。"
          }
        }
      }
    },
    "„%@“ wird noch benutzt. Löschen?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» لا يزال مستخدمًا. هل تريد حذفه؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” এখনও ব্যবহৃত হচ্ছে। মুছবেন?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is still in use. Delete it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» todavía está en uso. ¿Eliminar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est encore utilisée. La supprimer ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” अभी भी इस्तेमाल में है। हटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” masih dipakai. Hapus?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” è ancora in uso. Eliminare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はまだ使われています。削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 아직 쓰이고 있어요. 삭제할까요?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ainda está em uso. Excluir?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ещё используется. Удалить?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” hâlâ kullanılıyor. Silinsin mi?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ابھی بھی استعمال میں ہے۔ حذف کریں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” vẫn đang được dùng. Xóa chứ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”还在使用中。要删除吗？"
          }
        }
      }
    },
    "„Wie App“ nimmt die Farbe aus den Einstellungen. Eine eigene Farbe gilt nur für das Raster dieses Habits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«مثل التطبيق» يأخذ اللون من الإعدادات. اللون الخاص يسري على شبكة هذه العادة فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“অ্যাপের মতো” রংটি সেটিংস থেকে নেয়। নিজের রং কেবল এই অভ্যাসের গ্রিডে প্রযোজ্য।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Like app” takes the color from settings. A custom color applies only to this habit’s grid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Como la app» toma el color de los ajustes. Un color propio se aplica solo a la cuadrícula de este hábito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Comme l’app » reprend la couleur des réglages. Une couleur personnalisée ne vaut que pour la grille de cette habitude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“ऐप जैसा” रंग सेटिंग्स से लेता है। अपना रंग सिर्फ़ इसी आदत के ग्रिड पर लागू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Seperti aplikasi” memakai warna dari pengaturan. Warna sendiri hanya berlaku untuk kisi kebiasaan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Come l’app” prende il colore dalle impostazioni. Un colore personalizzato vale solo per la griglia di questa abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アプリに合わせる」は設定の色を使います。独自の色はこの習慣のグリッドだけに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“앱과 동일”은 설정의 색을 써요. 직접 고른 색은 이 습관의 격자에만 적용돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Como o app” usa a cor das configurações. Uma cor própria vale só para a grade deste hábito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Как в приложении» берёт цвет из настроек. Свой цвет действует только для сетки этой привычки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Uygulama gibi” rengi ayarlardan alır. Kendi rengin yalnızca bu alışkanlığın ızgarasında geçerlidir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“ایپ کی طرح” رنگ سیٹنگز سے لیتا ہے۔ اپنا رنگ صرف اسی عادت کے گرڈ پر لاگو ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Như ứng dụng” lấy màu từ cài đặt. Màu riêng chỉ áp dụng cho lưới của thói quen này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“跟随 App”会使用设置里的颜色。自定义颜色只作用于这个习惯的方格。"
          }
        }
      }
    },

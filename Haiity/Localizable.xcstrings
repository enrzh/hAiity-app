    "Hakt einen Habit für heute ab bzw. zählt ihn eins hoch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل إنجاز عادة لليوم أو يزيدها بمقدار واحد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অভ্যাসকে আজকের জন্য সম্পন্ন করে, বা তার গণনা এক বাড়ায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks off a habit for today, or counts it up by one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca un hábito como hecho hoy o le suma uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coche une habitude pour aujourd’hui, ou l’incrémente de un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी आदत को आज के लिए पूरा कर देता है या उसकी गिनती एक बढ़ा देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menandai kebiasaan sebagai selesai hari ini, atau menambah hitungannya satu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spunta un’abitudine per oggi oppure la incrementa di uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣を今日の分として完了にする、または1回分を加算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관을 오늘 완료로 표시하거나 횟수를 하나 올려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca um hábito como feito hoje ou soma mais um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечает привычку на сегодня или добавляет к ней единицу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alışkanlığı bugün için işaretler ya da sayısını bir artırır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی عادت کو آج کے لیے مکمل کرتا ہے یا اس کی گنتی ایک بڑھا دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu một thói quen là xong hôm nay, hoặc cộng thêm một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把某个习惯标记为今天已完成，或者给它加一次。"
          }
        }
      }
    },

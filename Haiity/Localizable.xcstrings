    "iCloud gerade nicht erreichbar (%@) — wird später nachgeholt.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud غير متاح حاليًا (%@) — سيتم تدارك ذلك لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud এখন পাওয়া যাচ্ছে না (%@) — পরে পুষিয়ে নেওয়া হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is unreachable right now (%@) — this will be caught up later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no está disponible ahora mismo (%@); se hará más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est momentanément injoignable (%@) — ce sera rattrapé plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud अभी उपलब्ध नहीं है (%@) — बाद में पूरा कर लिया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sedang tidak bisa dijangkau (%@) — akan disusul nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non è raggiungibile al momento (%@): verrà recuperato più tardi."

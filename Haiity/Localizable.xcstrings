    "Lücken sind kein Urteil. Sie sind nur Lücken.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفجوات ليست حكمًا. هي مجرد فجوات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাঁকগুলো কোনো রায় নয়। ওগুলো শুধু ফাঁক।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaps are not a verdict. They are just gaps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los huecos no son un juicio. Son solo huecos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trous ne sont pas un verdict. Ce sont juste des trous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली जगहें कोई फ़ैसला नहीं हैं। वे बस खाली जगहें हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotak bolong bukan vonis. Itu cuma bolong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I vuoti non sono un giudizio. Sono solo vuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いたマスは判決ではありません。ただ空いているだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 칸은 판결이 아닙니다. 그냥 빈 칸일 뿐이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As falhas não são um veredito. São apenas falhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропуски — это не приговор. Это просто пропуски."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluklar bir hüküm değil. Sadece boşluk."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خالی جگہیں کوئی فیصلہ نہیں ہیں۔ وہ بس خالی جگہیں ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những ô trống không phải lời phán xét. Chúng chỉ là ô trống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格不是判决。它们只是空格。"
          }
        }
      }
    },
    "Malen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلوين"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রং করা"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peindre"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",

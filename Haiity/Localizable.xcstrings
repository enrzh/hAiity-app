        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che usa questo colore torna al colore predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この色を使っているものはすべて標準の色に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 색을 쓰던 것은 모두 기본 색으로 돌아가요."

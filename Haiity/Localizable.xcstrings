    "Ein Habit auf dem Sperrbildschirm.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادة واحدة على شاشة القفل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক স্ক্রিনে একটি অভ্যাস।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One habit on the Lock Screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hábito en la pantalla bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une habitude sur l’écran verrouillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक स्क्रीन पर एक आदत।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu kebiasaan di Layar Terkunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’abitudine nella schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面に習慣をひとつ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면에 습관 하나."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um hábito na tela bloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна привычка на экране блокировки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit ekranında tek bir alışkanlık."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لاک اسکرین پر ایک عادت۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thói quen trên Màn hình khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定屏幕上的一个习惯。"
          }
        }
      }
    },
    "Ein Habit mit Serie, heutigem Stand und Abhak-Knopf.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادة واحدة مع السلسلة وحالة اليوم وزر التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি অভ্যাস — স্ট্রিক, আজকের অবস্থা আর সম্পন্ন করার বোতামসহ।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One habit with its streak, today’s progress and a check-off button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hábito con su racha, el progreso de hoy y un botón para marcarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une habitude avec sa série, l’avancement du jour et un bouton pour cocher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक आदत — स्ट्रीक, आज की स्थिति और पूरा करने का बटन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu kebiasaan dengan streak, progres hari ini, dan tombol centang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’abitudine con serie, l’andamento di oggi e un pulsante per spuntarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣ひとつを、連続記録・今日の状況・完了ボタンとともに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관 하나를 연속 기록, 오늘 진행 상황, 체크 버튼과 함께 보여줘요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um hábito com sequência, o progresso de hoje e um botão para marcar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна привычка с серией, сегодняшним прогрессом и кнопкой отметки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serisi, bugünkü durumu ve işaretleme düğmesiyle tek bir alışkanlık."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک عادت — سلسلہ، آج کی صورتحال اور مکمل کرنے کا بٹن۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thói quen kèm chuỗi, tiến độ hôm nay và nút đánh dấu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个习惯，显示连续记录、今天的进度和打卡按钮。"
          }
        }
      }
    },
    "Eine Farbe genügt — die fünf Stufen des Rasters rechnet hAiity daraus.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لون واحد يكفي — ويحسب hAiity منه درجات الشبكة الخمس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি রংই যথেষ্ট — গ্রিডের পাঁচটি স্তর hAiity সেখান থেকেই হিসাব করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One color is enough — hAiity derives the grid’s five levels from it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta un color: hAiity calcula a partir de él los cinco niveles de la cuadrícula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule couleur suffit — hAiity en déduit les cinq niveaux de la grille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही रंग काफ़ी है — ग्रिड के पाँचों स्तर hAiity उसी से निकाल लेता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu warna sudah cukup — lima tingkat kisinya dihitung hAiity dari situ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta un colore: hAiity ne ricava i cinque livelli della griglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色はひとつで十分です。グリッドの5段階はhAiityが算出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색 하나면 충분해요 — 격자의 다섯 단계는 hAiity가 계산해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cor basta — o hAiity calcula a partir dela os cinco níveis da grade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хватит одного цвета — пять уровней сетки hAiity посчитает сам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir renk yeter — ızgaranın beş tonunu hAiity ondan hesaplar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک رنگ کافی ہے — گرڈ کے پانچوں درجے hAiity اسی سے نکال لیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một màu là đủ — năm mức của lưới sẽ do hAiity tính ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个颜色就够了——方格的五个层级由 hAiity 推算。"
          }
        }
      }
    },
    "Einen Habit für heute abhaken.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل إنجاز عادة لليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অভ্যাস আজকের জন্য সম্পন্ন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check off a habit for today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca un hábito como hecho hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocher une habitude pour aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी आदत को आज के लिए पूरा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Centang kebiasaan untuk hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spunta un’abitudine per oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣を今日の分として完了にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관을 오늘 완료로 표시해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar um hábito como feito hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметить привычку на сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alışkanlığı bugün için işaretle."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی عادت کو آج کے لیے مکمل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu một thói quen cho hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给某个习惯打上今天的卡。"
          }
        }
      }
    },
    "Einmal": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرة واحدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1회"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 раз"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 次"
          }
        }
      }
    },
    "Einmal am Tag: wie viel von heute erledigt ist und was noch offen steht. Gezählt wird nur, was heute laut Regel ansteht.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرة في اليوم: كم أُنجز من اليوم وما الذي بقي. ولا يُحتسب إلا ما يحين اليوم بحسب القاعدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিনে একবার: আজ কতটা সম্পন্ন হয়েছে আর কী বাকি আছে। কেবল নিয়ম অনুযায়ী আজ যা নির্ধারিত, তাই গোনা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a day: how much of today is done and what is still open. Only what is due today by the rule is counted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al día: cuánto llevas hecho hoy y qué queda pendiente. Solo cuenta lo que hoy toca según la regla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par jour : ce qui est fait aujourd’hui et ce qui reste à faire. Seul ce qui est dû aujourd’hui selon la règle est compté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन में एक बार: आज कितना पूरा हुआ और क्या बाकी है। सिर्फ़ वही गिना जाता है जो नियम के हिसाब से आज तय है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali sehari: berapa banyak yang selesai hari ini dan apa yang masih tersisa. Yang dihitung hanya yang jatuh tempo hari ini menurut aturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta al giorno: quanto di oggi è fatto e cosa resta da fare. Conta solo ciò che oggi è previsto dalla regola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日1回、今日どれだけ終わったか、何が残っているかを知らせます。数えるのはルール上その日が対象のものだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에 한 번, 오늘 얼마나 했고 무엇이 남았는지 알려줘요. 규칙상 오늘 해당하는 것만 세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por dia: quanto de hoje está feito e o que ainda está pendente. Conta só o que vence hoje segundo a regra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день: сколько из сегодняшнего сделано и что осталось. Считается только то, что запланировано на сегодня по правилу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde bir kez: bugünden ne kadarı tamam, ne kalmış. Yalnızca kurala göre bugün gereken sayılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دن میں ایک بار: آج کتنا مکمل ہوا اور کیا باقی ہے۔ صرف وہی شمار ہوتا ہے جو قاعدے کے مطابق آج مقرر ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi ngày một lần: hôm nay đã xong bao nhiêu và còn lại gì. Chỉ tính những gì đến hạn hôm nay theo quy tắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天一次：今天完成了多少、还剩什么。只统计按规则今天该做的。"
          }
        }
      }
    },
    "Einmal in der Woche: wie viele der fälligen Termine du gehalten hast — und welche Habits zurückliegen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرة في الأسبوع: كم من المواعيد المستحقة التزمت بها — وأي العادات متأخرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সপ্তাহে একবার: নির্ধারিত দিনগুলোর কতগুলো আপনি রেখেছেন — আর কোন অভ্যাসগুলো পিছিয়ে আছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a week: how many of the due occurrences you kept — and which habits are falling behind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez a la semana: cuántas de las citas previstas has cumplido y qué hábitos se están quedando atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par semaine : combien d’échéances tu as tenues — et quelles habitudes sont à la traîne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हफ़्ते में एक बार: तय दिनों में से आपने कितने निभाए — और कौन-सी आदतें पीछे रह रही हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali seminggu: berapa banyak jadwal yang kamu penuhi — dan kebiasaan mana yang tertinggal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta a settimana: quante delle scadenze previste hai rispettato e quali abitudini sono rimaste indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週に1回、予定のうちどれだけ守れたか、どの習慣が遅れているかを知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일주일에 한 번, 예정된 일정 중 몇 개를 지켰는지 — 그리고 어떤 습관이 뒤처지는지 알려줘요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por semana: quantos dos compromissos previstos você cumpriu — e quais hábitos estão atrasados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в неделю: сколько запланированного ты выполнил — и какие привычки отстают."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada bir kez: planlı günlerin kaçını tuttun — ve hangi alışkanlıklar geride kalıyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہفتے میں ایک بار: مقررہ دنوں میں سے آپ نے کتنے نبھائے — اور کون سی عادات پیچھے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi tuần một lần: bạn đã giữ được bao nhiêu lịch hẹn — và thói quen nào đang tụt lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周一次：你按时完成了多少次安排——以及哪些习惯落后了。"
          }
        }
      }
    },

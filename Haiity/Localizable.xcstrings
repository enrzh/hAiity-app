    "Du musst heute nichts nachholen. Heute reicht heute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يلزمك تعويض شيء اليوم. اليوم يكفيه اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ কিছু পুষিয়ে নেওয়ার দরকার নেই। আজকের জন্য আজই যথেষ্ট।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have to make up for anything today. Today is enough for today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no tienes que recuperar nada. Hoy basta con hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n’as rien à rattraper aujourd’hui. Aujourd’hui suffit à aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज कुछ भी भरपाई करने की ज़रूरत नहीं। आज के लिए आज काफ़ी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu tidak perlu menebus apa pun hari ini. Hari ini cukup hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi non devi recuperare niente. Oggi basta oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日、取り返す必要はありません。今日は今日のぶんで十分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 무언가를 만회할 필요는 없어요. 오늘은 오늘로 충분합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não precisa compensar nada hoje. Hoje já basta hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня ничего не нужно навёрстывать. Сегодня достаточно сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün hiçbir şeyi telafi etmek zorunda değilsin. Bugüne bugün yeter."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کچھ پورا کرنے کی ضرورت نہیں۔ آج کے لیے آج کافی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay bạn không phải bù cho điều gì cả. Hôm nay chỉ cần hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天不用补什么。今天有今天就够了。"
          }
        }
      }
    },

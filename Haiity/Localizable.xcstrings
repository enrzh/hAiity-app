    "Bricht die laufende Habit-Session ab, ohne etwas abzuhaken.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلغي جلسة العادة الجارية دون تعليم أي شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চলমান হ্যাবিট-সেশন বাতিল করে, কিছুতে টিক না দিয়ে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancels the running habit session without checking anything off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela la sesión de hábito en curso sin marcar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annule la session d’habitude en cours sans rien cocher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चल रहे हैबिट-सेशन को बिना कुछ चिह्नित किए रद्द करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membatalkan sesi kebiasaan yang berjalan tanpa mencentang apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla la sessione di abitudine in corso senza spuntare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中の習慣セッションを、何もチェックせずに中止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 습관 세션을 아무것도 체크하지 않고 취소합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela a sessão de hábito em andamento sem marcar nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменяет текущую сессию привычки, ничего не отмечая."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süren alışkanlık seansını hiçbir şey işaretlemeden iptal eder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاری ہیبٹ سیشن منسوخ کرتا ہے، کسی چیز پر نشان لگائے بغیر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy phiên thói quen đang chạy mà không đánh dấu gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消正在进行的习惯计时，不勾选任何内容。"
          }
        }
      }
    },

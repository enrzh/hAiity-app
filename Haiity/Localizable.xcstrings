            "state": "translated",
            "value": "Serie complessiva di %lld giorni, serie migliore %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全体の連続記録は%lld日、最高記録は%lld日。"

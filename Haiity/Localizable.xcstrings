            "state": "translated",
            "value": "あなたに一文"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 문장 드려요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma frase para você"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна фраза для тебя"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana bir cümle"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے لیے ایک جملہ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một câu dành cho bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给你的一句话"
          }
        }
      }
    },
    "Ein Tag ist erledigt oder nicht.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم إما مُنجز أو غير مُنجز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি দিন হয় সম্পন্ন, নয়তো নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day is either done or not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día está hecho o no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée est faite ou non."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक दिन या तो पूरा होता है या नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah hari selesai atau tidak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno è fatto oppure no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日は完了か未完了かのどちらかです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루는 완료했거나 하지 않았거나입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dia está feito ou não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День либо выполнен, либо нет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir gün ya tamamlanır ya da tamamlanmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دن یا تو مکمل ہوتا ہے یا نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ngày hoặc đã xong hoặc chưa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一天要么完成，要么没完成。"
          }
        }
      }
    },
    "Ein Tag zählt, sobald das Ziel erreicht ist.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتسب اليوم بمجرد بلوغ الهدف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক্ষ্য পূরণ হলেই দিনটি গণনা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day counts as soon as the goal is reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día cuenta en cuanto se alcanza la meta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée compte dès que l’objectif est atteint."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य पूरा होते ही दिन गिना जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah hari dihitung begitu target tercapai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno conta appena l’obiettivo è raggiunto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標に達した時点でその日はカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표에 도달하면 그날은 달성으로 계산됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dia conta assim que a meta é alcançada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День засчитывается, как только достигнута цель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefe ulaşıldığı anda gün sayılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہدف پورا ہوتے ہی دن شمار ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ngày được tính ngay khi đạt mục tiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到目标后这一天就算完成。"
          }
        }
      }
    },
    "Ein einzelner Tag beweist nichts. Dafür gibt es die Reihe.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوم واحد لا يثبت شيئًا. ولهذا يوجد الصف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি দিন কিছুই প্রমাণ করে না। সারিটা সে কারণেই আছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single day proves nothing. That is what the row is for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo día no demuestra nada. Para eso está la fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jour isolé ne prouve rien. C’est à ça que sert la rangée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अकेला एक दिन कुछ साबित नहीं करता। कतार इसीलिए है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu hari saja tidak membuktikan apa-apa. Untuk itulah ada barisnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno solo non dimostra nulla. Per questo c’è la fila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日だけでは何も証明できません。だから列があるのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루만으로는 아무것도 증명되지 않아요. 그래서 줄이 있는 거예요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dia sozinho não prova nada. É para isso que existe a fileira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один день ничего не доказывает. Для этого и есть ряд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir gün hiçbir şey kanıtlamaz. Sıra tam da bunun için var."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکیلا ایک دن کچھ ثابت نہیں کرتا۔ قطار اسی لیے ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ngày đơn lẻ chẳng chứng minh điều gì. Hàng có mặt là vì thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独一天证明不了什么。所以才有整整一行。"
          }
        }
      }
    },
    "Ein neuer Tag im Raster": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوم جديد في الشبكة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রিডে নতুন একটি দিন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new day in the grid"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuevo día en la cuadrícula"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau jour dans la grille"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्रिड में एक नया दिन"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari baru di kisi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo giorno nella griglia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッドに新しい一日"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리드의 새로운 하루"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo dia na grade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый день в сетке"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgarada yeni bir gün"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گرڈ میں ایک نیا دن"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ngày mới trên lưới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格子里的新一天"
          }
        }
      }
    },
    "Eine Farbe genügt — die fünf Stufen des Rasters rechnet hAiity daraus.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لون واحد يكفي — ويحسب hAiity منه درجات الشبكة الخمس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি রংই যথেষ্ট — গ্রিডের পাঁচটি স্তর hAiity সেখান থেকেই হিসাব করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One color is enough — hAiity derives the grid’s five levels from it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta un color: hAiity calcula a partir de él los cinco niveles de la cuadrícula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule couleur suffit — hAiity en déduit les cinq niveaux de la grille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही रंग काफ़ी है — ग्रिड के पाँचों स्तर hAiity उसी से निकाल लेता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu warna sudah cukup — lima tingkat kisinya dihitung hAiity dari situ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta un colore: hAiity ne ricava i cinque livelli della griglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色はひとつで十分です。グリッドの5段階はhAiityが算出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색 하나면 충분해요 — 격자의 다섯 단계는 hAiity가 계산해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cor basta — o hAiity calcula a partir dela os cinco níveis da grade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хватит одного цвета — пять уровней сетки hAiity посчитает сам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir renk yeter — ızgaranın beş tonunu hAiity ondan hesaplar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک رنگ کافی ہے — گرڈ کے پانچوں درجے hAiity اسی سے نکال لیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một màu là đủ — năm mức của lưới sẽ do hAiity tính ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个颜色就够了——方格的五个层级由 hAiity 推算。"
          }
        }
      }
    },
    "Eine Notiz": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملاحظة"
          }
        },
        "bn": {

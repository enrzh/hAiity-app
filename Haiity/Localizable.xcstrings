        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がiOSの設定でオフになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정에서 알림이 꺼져 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas nos ajustes do iOS."

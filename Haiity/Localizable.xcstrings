    "Beantwortet einen Ja/Nein-Habit für heute mit Nein.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجيب بعادة نعم/لا بـ«لا» لليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হ্যাঁ/না হ্যাবিটের আজকের উত্তর না দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers a yes/no habit with no for today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde un hábito de sí/no con un no para hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répond non à une habitude oui/non pour aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाँ/ना आदत का आज के लिए ना में जवाब देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjawab tidak untuk habit ya/tidak hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risponde no a un'abitudine sì/no per oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい/いいえのハビットに今日「いいえ」と答えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예/아니요 해빗에 오늘 아니요로 답합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde não a um hábito de sim/não para hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвечает «нет» на привычку да/нет за сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir evet/hayır alışkanlığını bugün için hayır olarak yanıtlar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاں/نہیں عادت کا آج کے لیے نہیں میں جواب دیتا ہے۔"
          }
        },
        "vi": {

        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo su questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에만"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só neste dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только на этом устройстве"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu cihazda"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف اسی ڈیوائس پر"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ trên thiết bị này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在这台设备上"
          }
        }
      }
    },
    "Nur das Raster — sieben Zeilen, randlos.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشبكة فقط — سبعة صفوف بلا هوامش."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু গ্রিড — সাতটি সারি, প্রান্তহীন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just the grid — seven rows, edge to edge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la cuadrícula: siete filas, sin márgenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste la grille — sept lignes, sans marges."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ ग्रिड — सात पंक्तियाँ, बिना किनारे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya kisinya — tujuh baris, tanpa tepi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la griglia: sette righe, senza margini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッドだけ。7行、余白なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "격자만 — 일곱 줄, 여백 없이."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a grade — sete linhas, sem margens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только сетка — семь строк, без полей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece ızgara — yedi satır, kenarsız."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف گرڈ — سات قطاریں، بغیر حاشیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lưới — bảy hàng, không viền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有方格——七行，无边距。"
          }
        }
      }
    },
    "Nur eine Angabe am Termin — sie erinnert nicht. Erinnerungen laufen über die Zusammenfassungen in „Mehr“.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجرد معلومة على الموعد — لا تُذكّرك. التذكيرات تأتي من الملخّصات في «المزيد»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি কেবল নির্ধারিত দিনের একটি তথ্য — এটি মনে করিয়ে দেয় না। রিমাইন্ডার আসে “আরও”-এর সারসংক্ষেপ থেকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just a note on the occurrence — it doesn’t remind you. Reminders come from the summaries in “More”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un dato en la cita: no te avisa. Los avisos llegan desde los resúmenes en «Más»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une simple indication sur l’échéance — elle ne te rappelle rien. Les rappels passent par les récapitulatifs dans « Plus »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सिर्फ़ तय दिन पर लिखा एक ब्योरा है — यह याद नहीं दिलाता। रिमाइंडर “अधिक” के सारांशों से आते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya keterangan pada jadwal — ini tidak mengingatkanmu. Pengingat datang dari ringkasan di “Lainnya”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un’indicazione sulla scadenza: non ti avvisa. I promemoria arrivano dai riepiloghi in “Altro”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定に書き添えるだけで、通知はしません。リマインダーは「その他」のまとめから届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정에 적어두는 정보일 뿐, 알림은 오지 않아요. 알림은 “더 보기”의 요약에서 보내드려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É só uma informação no compromisso — ela não lembra você. Os lembretes vêm dos resumos em “Mais”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это лишь пометка к запланированному — она не напоминает. Напоминания приходят из сводок в «Ещё»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca o güne ait bir bilgi — hatırlatma yapmaz. Hatırlatmalar “Daha fazla” içindeki özetlerden gelir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ صرف مقررہ دن کی ایک تفصیل ہے — یہ یاد دہانی نہیں کراتا۔ یاد دہانیاں “مزید” کے خلاصوں سے آتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ là một ghi chú cho lịch hẹn — nó không nhắc bạn. Lời nhắc đến từ các bản tóm tắt trong “Thêm”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只是安排上的一个标注——它不会提醒你。提醒来自“更多”里的总结。"
          }
        }
      }
    },
    "Ohne Startdatum gilt die Regel für die ganze Historie — so bleiben Quoten und Serien älterer Habits unverändert.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون تاريخ بدء تسري القاعدة على السجل كله — وهكذا تبقى نسب وسلاسل العادات القديمة كما هي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরুর তারিখ ছাড়া নিয়মটি পুরো ইতিহাসে প্রযোজ্য — এতে পুরোনো অভ্যাসের হার ও স্ট্রিক অপরিবর্তিত থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a start date the rule applies to the whole history — that keeps rates and streaks of older habits unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin fecha de inicio la regla se aplica a todo el historial, así las tasas y las rachas de los hábitos antiguos no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans date de début, la règle s’applique à tout l’historique — les taux et les séries des anciennes habitudes restent inchangés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आरंभ तिथि के बिना नियम पूरे इतिहास पर लागू होता है — इससे पुरानी आदतों की दरें और स्ट्रीक अपरिवर्तित रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa tanggal mulai, aturannya berlaku untuk seluruh riwayat — sehingga rasio dan streak kebiasaan lama tetap sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza data d’inizio la regola vale per tutta la cronologia: così percentuali e serie delle abitudini più vecchie restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始日を設定しない場合、ルールは履歴全体に適用されます。古い習慣の達成率や連続記録はそのまま保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작일이 없으면 규칙이 전체 기록에 적용돼요 — 그래서 예전 습관의 달성률과 연속 기록이 그대로 유지돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem data de início a regra vale para todo o histórico — assim as taxas e sequências dos hábitos antigos não mudam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без даты начала правило действует на всю историю — так проценты и серии старых привычек остаются прежними."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç tarihi olmadan kural tüm geçmiş için geçerlidir — böylece eski alışkanlıkların oranları ve serileri değişmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آغاز کی تاریخ کے بغیر قاعدہ پوری تاریخ پر لاگو ہوتا ہے — یوں پرانی عادات کی شرحیں اور سلسلے برقرار رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có ngày bắt đầu thì quy tắc áp dụng cho toàn bộ lịch sử — nhờ vậy tỷ lệ và chuỗi của các thói quen cũ không đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不设开始日期时，规则对整段历史生效——这样老习惯的完成率和连续记录都不会改变。"
          }
        }
      }
    },
    "Ohne gewählten Wochentag steht nie ein Termin an. Check-ins zählen trotzdem.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون اختيار يوم من الأسبوع لن يحين أي موعد أبدًا. تسجيلات الإنجاز تُحتسب على أي حال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো বার বেছে না নিলে কখনও কিছু নির্ধারিত হয় না। চেক-ইন তবুও গোনা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With no weekday selected nothing is ever due. Check-ins still count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no eliges ningún día de la semana, nunca toca nada. Los check-ins cuentan igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans jour de la semaine sélectionné, rien n’est jamais dû. Les check-ins comptent quand même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई वार चुने बिना कभी कुछ तय नहीं होता। चेक-इन फिर भी गिने जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa hari yang dipilih, tidak pernah ada jadwal. Check-in tetap dihitung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un giorno della settimana selezionato non scade mai nulla. I check-in contano lo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曜日を選ばないと予定は一度も入りません。チェックインはそれでもカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요일을 하나도 고르지 않으면 예정이 잡히지 않아요. 체크인은 그래도 집계돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem nenhum dia da semana escolhido, nunca vence nada. Os check-ins contam mesmo assim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если день недели не выбран, ничего никогда не запланировано. Чек-ины всё равно засчитываются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir gün seçilmezse hiçbir zaman bir şey gerekmez. Check-in’ler yine de sayılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی دن منتخب کیے بغیر کبھی کچھ مقرر نہیں ہوتا۔ چیک اِن پھر بھی شمار ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không chọn thứ nào thì sẽ không bao giờ có lịch. Các lần check-in vẫn được tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有选中任何星期几，就永远不会有安排。打卡照样计入。"
          }
        }
      }
    },
    "Optional: deine Daten in einem privaten Repo deines GitHub-Accounts.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري: بياناتك في Repo خاص داخل حسابك على GitHub."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক: আপনার ডেটা আপনার GitHub অ্যাকাউন্টের একটি প্রাইভেট Repo-তে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: your data in a private repo in your GitHub account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: tus datos en un repo privado de tu cuenta de GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : tes données dans un repo privé de ton compte GitHub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक: आपका डेटा आपके GitHub अकाउंट के एक प्राइवेट Repo में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional: datamu di repo privat pada akun GitHub-mu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo: i tuoi dati in un repo privato del tuo account GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：データをあなたのGitHubアカウントのプライベートRepoに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: 내 GitHub 계정의 비공개 Repo에 데이터를 보관해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: seus dados em um repo privado da sua conta do GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По желанию: твои данные в приватном Repo твоего аккаунта GitHub."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı: verilerin GitHub hesabındaki özel bir repoda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختیاری: آپ کا ڈیٹا آپ کے GitHub اکاؤنٹ کے ایک نجی Repo میں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn: dữ liệu của bạn trong một repo riêng tư thuộc tài khoản GitHub của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：把你的数据放进你 GitHub 账户下的一个私有 Repo。"
          }
        }
      }
    },
    "Optional: deine Daten in einem privaten Repo deines GitHub-Accounts. Ein Tipp, ein Code, fertig.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري: بياناتك في Repo خاص داخل حسابك على GitHub. ضغطة واحدة، رمز واحد، وانتهى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক: আপনার ডেটা আপনার GitHub অ্যাকাউন্টের একটি প্রাইভেট Repo-তে। এক ট্যাপ, এক কোড, ব্যস।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: your data in a private repo in your GitHub account. One tap, one code, done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: tus datos en un repo privado de tu cuenta de GitHub. Un toque, un código, listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : tes données dans un repo privé de ton compte GitHub. Un tap, un code, c’est fait."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक: आपका डेटा आपके GitHub अकाउंट के एक प्राइवेट Repo में। एक टैप, एक कोड, हो गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional: datamu di repo privat pada akun GitHub-mu. Sekali ketuk, satu kode, selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo: i tuoi dati in un repo privato del tuo account GitHub. Un tocco, un codice, fatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：データをあなたのGitHubアカウントのプライベートRepoに。タップひとつ、コードひとつで完了。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: 내 GitHub 계정의 비공개 Repo에 데이터를 보관해요. 한 번 탭하고 코드만 넣으면 끝."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: seus dados em um repo privado da sua conta do GitHub. Um toque, um código, pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По желанию: твои данные в приватном Repo твоего аккаунта GitHub. Одно нажатие, один код — готово."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı: verilerin GitHub hesabındaki özel bir repoda. Bir dokunuş, bir kod, tamam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختیاری: آپ کا ڈیٹا آپ کے GitHub اکاؤنٹ کے ایک نجی Repo میں۔ ایک ٹیپ، ایک کوڈ، ہو گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn: dữ liệu của bạn trong một repo riêng tư thuộc tài khoản GitHub của bạn. Một chạm, một mã, xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：把你的数据放进你 GitHub 账户下的一个私有 Repo。轻点一下，输入一个代码，搞定。"
          }
        }
      }
    },

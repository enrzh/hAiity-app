    "Archivierte Habits behalten ihre Historie und tauchen hier auf.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العادات المؤرشفة تحتفظ بسجلّها وتظهر هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আর্কাইভ করা অভ্যাস তাদের ইতিহাস ধরে রাখে এবং এখানে দেখা যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived habits keep their history and show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hábitos archivados conservan su historial y aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les habitudes archivées conservent leur historique et apparaissent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रहित आदतें अपना इतिहास बनाए रखती हैं और यहाँ दिखती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebiasaan yang diarsipkan tetap menyimpan riwayatnya dan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le abitudini archiviate conservano la cronologia e compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブした習慣は履歴を保ったまま、ここに並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관한 습관은 기록을 그대로 간직한 채 여기에 모여요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hábitos arquivados mantêm o histórico e aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивные привычки сохраняют историю и появляются здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenen alışkanlıklar geçmişini korur ve burada görünür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرکائیو کی گئی عادات اپنی تاریخ برقرار رکھتی ہیں اور یہاں نظر آتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thói quen đã lưu trữ vẫn giữ lịch sử và xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档的习惯会保留历史记录，并出现在这里。"
          }
        }
      }
    },
    "Aus": {
      "localizations": {

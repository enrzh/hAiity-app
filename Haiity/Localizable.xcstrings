    "Nicht bei iCloud angemeldet — die Daten bleiben auf diesem Gerät.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تسجيل الدخول إلى iCloud — تبقى البيانات على هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-এ সাইন ইন করা নেই — ডেটা এই ডিভাইসেই থাকবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed in to iCloud — the data stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin sesión iniciada en iCloud: los datos se quedan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non connecté à iCloud — les données restent sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud में साइन इन नहीं — डेटा इसी डिवाइस पर रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum masuk ke iCloud — datanya tetap di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso a iCloud: i dati restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudにサインインしていません。データはこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인되어 있지 않아요 — 데이터는 이 기기에 남아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem login no iCloud — os dados ficam neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в iCloud не выполнен — данные остаются на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud’a giriş yapılmadı — veriler bu cihazda kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud میں سائن اِن نہیں — ڈیٹا اسی ڈیوائس پر رہے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đăng nhập iCloud — dữ liệu ở lại trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未登录 iCloud——数据留在这台设备上。"
          }
        }
      }
    },
    "Nichts offen geblieben. Das war ein guter Tag.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يبقَ شيء معلّق. كان يومًا جيدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু বাকি নেই। ভালো একটা দিন ছিল।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing left open. That was a good day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada quedó pendiente. Fue un buen día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est resté en suspens. C'était une bonne journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ बाकी नहीं रहा। अच्छा दिन था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada yang tersisa. Hari yang baik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente è rimasto in sospeso. È stata una buona giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やり残しゼロ。いい一日でした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 게 없어요. 좋은 하루였어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada ficou aberto. Foi um bom dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не осталось. Это был хороший день."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey açık kalmadı. Güzel bir gündü."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ باقی نہیں رہا۔ اچھا دن تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không còn gì dang dở. Một ngày tốt lành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有遗留任何事。这是美好的一天。"
          }
        }
      }
    },
    "Niemand füllt jede Zelle. Die Reihe bleibt trotzdem deine.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يملأ كل خلية. يبقى الصف صفك على أي حال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি ঘর কেউই ভরে না। সারিটা তবু আপনারই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody fills every cell. The row is still yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie llena todas las celdas. La fila sigue siendo tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne remplit toutes les cases. La rangée reste la tienne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सेल कोई नहीं भरता। कतार फिर भी आपकी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang mengisi semua sel. Barisnya tetap milikmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno riempie ogni cella. La fila resta comunque tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのマスを埋める人はいません。それでも列はあなたのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 칸을 채우는 사람은 없어요. 그래도 그 줄은 온전히 내 것입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém preenche todas as células. A fileira continua sendo sua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не закрашивает все клетки. Ряд всё равно твой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimse her hücreyi doldurmaz. Sıra yine de senin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر خانہ کوئی نہیں بھرتا۔ قطار پھر بھی آپ کی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ai lấp đầy mọi ô. Hàng đó vẫn là của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有人能填满每一格。这一行依然是你的。"
          }
        }
      }
    },

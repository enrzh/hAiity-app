    "Zugriff in GitHub abgelehnt — es wurde nichts verbunden.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رُفض الوصول في GitHub — لم يتم ربط أي شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub-এ অ্যাক্সেস প্রত্যাখ্যাত — কিছুই সংযুক্ত হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access denied in GitHub — nothing was connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso denegado en GitHub: no se conectó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès refusé dans GitHub — rien n’a été connecté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub में एक्सेस अस्वीकार किया गया — कुछ भी कनेक्ट नहीं हुआ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses ditolak di GitHub — tidak ada yang terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso negato in GitHub — non è stato connesso nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubでアクセスが拒否されました——何も接続されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 접근이 거부됐어요 — 아무것도 연결되지 않았어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso negado no GitHub — nada foi conectado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ в GitHub отклонён — ничего не подключено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub'da erişim reddedildi — hiçbir şey bağlanmadı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub میں رسائی مسترد — کچھ بھی منسلک نہیں ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập bị từ chối trong GitHub — chưa có gì được kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 中拒绝了授权——什么都没有连接。"
          }
        }
      }
    },
    "Zuletzt abgeglichen um %@. Kein Konto, keine Anmeldung in der App.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر مزامنة في %@. لا حساب ولا تسجيل دخول داخل التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বশেষ সিঙ্ক %@-এ। কোনো অ্যাকাউন্ট নেই, অ্যাপে সাইন ইন নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last synced at %@. No account, no sign-in in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última sincronización a las %@. Sin cuenta, sin iniciar sesión en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière synchronisation à %@. Aucun compte, aucune connexion dans l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आख़िरी सिंक %@ बजे। कोई अकाउंट नहीं, ऐप में कोई साइन-इन नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terakhir disinkronkan pukul %@. Tanpa akun, tanpa masuk di aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima sincronizzazione alle %@. Nessun account, nessun accesso nell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終同期は%@。アカウントもアプリ内のサインインも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 동기화 %@. 계정도, 앱 내 로그인도 없어요."
          }
        },

    "Archivieren erhält die Historie. Endgültig löschen kannst du im Archiv (Mehr → Archiv).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأرشفة تحافظ على السجلّ. يمكنك الحذف نهائيًا من الأرشيف (المزيد ← الأرشيف)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আর্কাইভ করলে ইতিহাস থেকে যায়। চিরতরে মুছতে হলে আর্কাইভে যান (আরও → আর্কাইভ)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiving keeps the history. You can delete for good in the Archive (More → Archive)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivar conserva el historial. Puedes eliminarlo definitivamente en el Archivo (Más → Archivo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiver conserve l’historique. Tu peux supprimer définitivement dans les Archives (Plus → Archives)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रह करने पर इतिहास बना रहता है। हमेशा के लिए हटाना संग्रह में जाकर करें (अधिक → संग्रह)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengarsipkan tetap menyimpan riwayat. Menghapus permanen bisa dilakukan di Arsip (Lainnya → Arsip)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviare conserva la cronologia. Puoi eliminare definitivamente nell’Archivio (Altro → Archivio)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブすれば履歴は残ります。完全に削除するのはアーカイブから（その他 → アーカイブ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관하면 기록은 그대로 남아요. 완전히 삭제하려면 보관함에서 하세요(더 보기 → 보관함)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivar mantém o histórico. Você pode excluir de vez no Arquivo (Mais → Arquivo)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивирование сохраняет историю. Удалить навсегда можно в Архиве (Ещё → Архив)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlemek geçmişi korur. Kalıcı olarak silmeyi Arşiv'den yapabilirsin (Daha fazla → Arşiv)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرکائیو کرنے سے تاریخ محفوظ رہتی ہے۔ ہمیشہ کے لیے حذف آرکائیو سے کریں (مزید ← آرکائیو)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu trữ vẫn giữ lại lịch sử. Muốn xóa vĩnh viễn thì vào Lưu trữ (Thêm → Lưu trữ)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档会保留历史记录。要彻底删除，请到归档里操作（更多 → 归档）。"
          }
        }
      }
    },
    "Archiviert am %@ · %lld Check-ins": {
      "localizations": {

    "Das App-Icon per Farbrad setzen? Das ist Pro.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط أيقونة التطبيق عبر عجلة الألوان؟ هذا في Pro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কালার হুইল দিয়ে App-Icon বসাবেন? সেটা Pro-তে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the app icon from a color wheel? That’s Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Elegir el icono de la app con la rueda de color? Eso es Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir l’icône de l’app via la roue chromatique ? C’est Pro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कलर व्हील से App-Icon सेट करना? वह Pro में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyetel App-Icon lewat roda warna? Itu Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostare l’icona dell’app dalla ruota dei colori? Quello è Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カラーホイールでApp-Iconを設定？それはProです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상환으로 App-Icon 설정? 그건 Pro예요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir o ícone do app pela roda de cores? Isso é Pro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать значок приложения через цветовой круг? Это Pro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama simgesini renk çarkıyla ayarlamak mı? O Pro’da."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلر وہیل سے App-Icon سیٹ کرنا؟ وہ Pro میں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt biểu tượng ứng dụng bằng vòng màu? Đó là Pro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想用色轮设置 App-Icon？那是 Pro。"
          }
        }
      }
    },
    "Das Raster fragt nicht nach Motivation. Es fragt nach heute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشبكة لا تسأل عن الحماس. تسأل عن اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রিড অনুপ্রেরণার খোঁজ করে না। সে আজকের খোঁজ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grid does not ask about motivation. It asks about today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuadrícula no pregunta por la motivación. Pregunta por hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La grille ne demande pas de motivation. Elle demande aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्रिड प्रेरणा नहीं पूछती। वह आज पूछती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisi tidak menanyakan motivasi. Ia menanyakan hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La griglia non chiede motivazione. Chiede oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッドはやる気を尋ねません。今日を尋ねます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리드는 의욕을 묻지 않아요. 오늘을 물을 뿐입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A grade não pergunta por motivação. Pergunta por hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетка не спрашивает про мотивацию. Она спрашивает про сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgara motivasyon sormaz. Bugünü sorar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گرڈ جذبہ نہیں پوچھتا۔ وہ آج پوچھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưới không hỏi về động lực. Nó hỏi về hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格子不问你有没有动力。它只问今天。"
          }
        }
      }
    },
    "Das Raster meldet sich": {
      "localizations": {

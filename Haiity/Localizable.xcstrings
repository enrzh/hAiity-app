    "Wähl die Farbe des App-Icons frei statt aus der Liste der Paletten.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لون أيقونة التطبيق بحرية بدلًا من قائمة لوحات الألوان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Icon-এর রং প্যালেটের তালিকা থেকে নয়, নিজের ইচ্ছেমতো বেছে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the app icon’s color freely instead of from the list of palettes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige libremente el color del icono de la app en vez de tomarlo de la lista de paletas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis librement la couleur de l’icône de l’app au lieu de la prendre dans la liste des palettes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Icon का रंग पैलेट की सूची से नहीं, बल्कि आज़ादी से चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih warna App-Icon dengan bebas, bukan dari daftar palet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli liberamente il colore dell’icona dell’app invece di prenderlo dall’elenco delle tavolozze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Iconの色をパレット一覧からではなく、自由に選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Icon 색을 팔레트 목록이 아니라 자유롭게 고를 수 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha livremente a cor do ícone do app em vez de pegar da lista de paletas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирай цвет App-Icon свободно, а не из списка палитр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Icon’un rengini palet listesinden değil, serbestçe seç."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Icon کا رنگ پیلیٹ کی فہرست سے نہیں، آزادانہ چنیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn màu App-Icon tùy ý thay vì lấy từ danh sách bảng màu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Icon 的颜色可以自由选择，而不必从调色板列表里挑。"
          }
        }
      }
    },

    "Was heute fällig ist — Segment für Segment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هو مستحق اليوم — قطعة قطعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ যা করার আছে — ভাগে ভাগে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What’s due today — segment by segment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que toca hoy, segmento a segmento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est à faire aujourd’hui — segment par segment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज क्या करना है — हिस्से-दर-हिस्से।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang harus dilakukan hari ini — segmen demi segmen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa tocca oggi — segmento per segmento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日やること — セグメントごとに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 할 일 — 부분별로."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que vence hoje — segmento por segmento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что на сегодня — сегмент за сегментом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün ne var — dilim dilim."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کیا کرنا ہے — حصہ بہ حصہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc đến hạn hôm nay — từng phần một."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日待办——逐段显示。"
          }
        }
      }
    },

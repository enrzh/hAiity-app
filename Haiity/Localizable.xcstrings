    "Zeigt beim Tippen die Serien je Habit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر لعرض السلاسل حسب العادة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্যাপ করলে অভ্যাস-প্রতি স্ট্রিক দেখায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to show streaks per habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para ver las rachas por hábito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche pour voir les séries par habitude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैप करने पर हर आदत की स्ट्रीक दिखती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk melihat streak per kebiasaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per vedere le serie per abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップすると習慣ごとの連続記録を表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 습관별 연속 기록을 보여줍니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para ver as sequências por hábito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми, чтобы увидеть серии по привычкам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokununca alışkanlık başına serileri gösterir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیپ کرنے پر ہر عادت کا سلسلہ دکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để xem chuỗi theo từng thói quen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按查看各习惯的连续天数。"
          }
        }
      }

    "Kommt in 10 Sekunden — auch bei geöffneter App.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصل خلال 10 ثوانٍ — حتى والتطبيق مفتوح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "10 সেকেন্ডে আসবে — অ্যাপ খোলা থাকলেও।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrives in 10 seconds — even with the app open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega en 10 segundos, incluso con la app abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrive dans 10 secondes — même app ouverte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "10 सेकंड में आएगी — ऐप खुला होने पर भी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiba dalam 10 detik — meski aplikasi terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriva tra 10 secondi — anche con l’app aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10秒後に届きます。アプリを開いていても表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10초 뒤에 도착해요 — 앱이 열려 있어도요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chega em 10 segundos — mesmo com o app aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Придёт через 10 секунд — даже при открытом приложении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 saniye içinde gelir — uygulama açıkken bile."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "10 سیکنڈ میں آئے گی — ایپ کھلی ہو تب بھی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đến sau 10 giây — kể cả khi app đang mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 秒后送达——App 打开时也会显示。"
          }
        }
      }
    },
    "Komplett! Aus Tagen wie diesem bauen sich die Streaks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل! من أيام كهذه تُبنى السلاسل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পূর্ণ! এমন দিন থেকেই স্ট্রিক গড়ে ওঠে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete! Streaks are built from days like this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Completo! Las rachas se construyen con días así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complet ! Les séries se construisent avec des jours comme ça."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा! ऐसे ही दिनों से सिलसिले बनते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengkap! Streak dibangun dari hari seperti ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completo! Le serie si costruiscono con giorni così."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンプリート！連続記録はこういう日から生まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료! 스트릭은 이런 날들로 만들어져요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Completo! Sequências nascem de dias assim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово! Из таких дней и складываются серии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlandı! Seriler böyle günlerden kurulur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مکمل! ایسے ہی دنوں سے سلسلے بنتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất! Chuỗi ngày được xây từ những hôm thế này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成！连击就是由这样的日子筑成的。"
          }
        }
      }
    },

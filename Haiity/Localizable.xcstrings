    "Jede Auswertung im Detail statt nur der Kacheln der Übersicht.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تحليل بتفاصيله، لا مربعات النظرة العامة وحدها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু সারসংক্ষেপের টাইল নয়, প্রতিটি বিশ্লেষণ বিস্তারিতভাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every analysis in detail instead of only the overview tiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada análisis en detalle, no solo los recuadros del resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque analyse en détail, pas seulement les tuiles de la vue d’ensemble."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ अवलोकन की टाइलें नहीं, हर विश्लेषण विस्तार से।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap analisis secara rinci, bukan cuma petak ringkasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni analisi nel dettaglio, non solo i riquadri della panoramica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "概要のタイルだけでなく、すべての分析を詳しく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개요 타일만이 아니라 모든 분석을 자세히."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada análise em detalhe, não só os blocos do resumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый разбор в подробностях, а не только плитки обзора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her değerlendirme ayrıntısıyla, sadece genel bakıştaki kutucuklar değil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف خلاصے کی ٹائلیں نہیں، ہر تجزیہ تفصیل سے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi phân tích đều chi tiết, không chỉ các ô tổng quan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一项分析都能看细节，而不只是概览里的方块。"
          }
        }
      }
    },

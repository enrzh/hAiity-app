    "%@ steht heute schon auf Nein.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ مضبوط اليوم على لا بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আজ আগেই না-তে আছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already set to no today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está en no hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà sur non aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ आज पहले से ना पर है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hari ini sudah tidak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già su no oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は今日すでに「いいえ」です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 오늘 이미 아니요입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já está em não hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже стоит на «нет» сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bugün zaten hayırda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ آج پہلے ہی نہیں پر ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hôm nay đã là không."
          }

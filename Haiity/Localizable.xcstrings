    "Auf diesem Konto liegt kein früherer Kauf von hAiity Pro.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد على هذا الحساب شراء سابق لـ hAiity Pro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টে hAiity Pro-র আগের কোনো কেনা নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There’s no earlier hAiity Pro purchase on this account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta cuenta no hay ninguna compra anterior de hAiity Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat antérieur de hAiity Pro sur ce compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अकाउंट पर hAiity Pro की कोई पिछली ख़रीद नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pembelian hAiity Pro sebelumnya di akun ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo account non risulta alcun acquisto precedente di hAiity Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントにhAiity Proの過去の購入はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에는 이전에 구입한 hAiity Pro가 없어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nenhuma compra anterior do hAiity Pro nesta conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом аккаунте нет более ранней покупки hAiity Pro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesapta daha önce yapılmış bir hAiity Pro satın alımı yok."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اکاؤنٹ پر hAiity Pro کی کوئی پچھلی خریداری نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này chưa từng mua hAiity Pro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个账号上没有此前的 hAiity Pro 购买记录。"
          }
        }
      }
    },
    "Aus Wiederholung wird Routine, und Routine braucht irgendwann keine Erinnerung mehr.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التكرار يصير روتينًا، والروتين لا يحتاج يومًا ما إلى تذكير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরাবৃত্তি একসময় রুটিন হয়, আর রুটিনের একদিন আর মনে করিয়ে দেওয়ার দরকার থাকে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetition turns into routine, and at some point routine needs no reminder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La repetición se vuelve rutina, y en algún momento la rutina ya no necesita recordatorios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La répétition devient routine, et un jour la routine n’a plus besoin de rappel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराव आदत बन जाता है, और आदत को कभी रिमाइंडर की ज़रूरत नहीं रहती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengulangan berubah jadi rutinitas, dan suatu saat rutinitas tak perlu pengingat lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ripetizione diventa routine, e a un certo punto la routine non ha più bisogno di promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しはやがて習慣になり、習慣はいつかリマインドを必要としなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복은 루틴이 되고, 루틴은 언젠가 알림이 필요 없어집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A repetição vira rotina, e em algum momento a rotina não precisa mais de lembrete."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторение превращается в рутину, и однажды рутине уже не нужны напоминания."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar rutine dönüşür ve rutin bir gün hatırlatmaya ihtiyaç duymaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دہرانا معمول بن جاتا ہے، اور معمول کو کبھی یاد دہانی کی ضرورت نہیں رہتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lặp lại sẽ thành thói quen, và tới lúc nào đó thói quen chẳng cần lời nhắc nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复会变成惯例，而惯例迟早不再需要提醒。"
          }
        }
      }
    },

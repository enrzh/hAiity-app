    "Anfangen dauert meistens kürzer als das Nachdenken übers Anfangen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البدء غالبًا أقصر من التفكير في البدء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু করাটা সাধারণত শুরু করার কথা ভাবার চেয়ে কম সময় নেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting usually takes less time than thinking about starting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar suele durar menos que pensar en empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer prend en général moins de temps que réfléchir à commencer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करना अक्सर शुरू करने के बारे में सोचने से कम समय लेता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulai biasanya lebih cepat daripada memikirkan cara memulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cominciare di solito dura meno che pensare a cominciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始めることは、たいてい始めるかどうか考えるより短く済みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하는 건 보통 시작할지 고민하는 것보다 짧게 끝나요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar costuma levar menos tempo do que pensar em começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать обычно быстрее, чем думать о том, чтобы начать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak, çoğu zaman başlamayı düşünmekten kısa sürer."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع کرنا اکثر شروع کرنے کے بارے میں سوچنے سے کم وقت لیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu thường nhanh hơn là nghĩ về việc bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始通常比琢磨要不要开始更快。"
          }
        }
      }
    },

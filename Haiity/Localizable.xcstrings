    "Gefragt wird nur, wenn du eine Erinnerung einschaltest — nie einfach so.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن نسألك إلا عند تفعيل تذكير — وليس من دون سبب أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু রিমাইন্ডার চালু করলেই জিজ্ঞাসা করা হবে — এমনি এমনি কখনো নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll only be asked when you turn on a reminder — never out of the blue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se te preguntará cuando actives un recordatorio — nunca porque sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne te le demandera que si tu actives un rappel — jamais sans raison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ तभी पूछा जाएगा जब आप रिमाइंडर चालू करें — यूँ ही कभी नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu hanya akan ditanya saat mengaktifkan pengingat — tidak pernah tanpa alasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti verrà chiesto solo quando attivi un promemoria — mai senza motivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーをオンにしたときだけ確認します——それ以外で聞くことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리마인더를 켤 때만 물어봐요 — 그냥 묻는 일은 없어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só perguntamos quando você ativa um lembrete — nunca do nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос появится, только когда ты включишь напоминание — и никогда просто так."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bir hatırlatıcı açtığında sorulur — asla durduk yere değil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف تب پوچھا جائے گا جب آپ یاد دہانی آن کریں — کبھی بلا وجہ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ hỏi khi bạn bật lời nhắc — không bao giờ hỏi vu vơ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你开启提醒时才会询问——绝不会无缘无故打扰。"
          }
        }
      }
    },

    "Welcher Habit in diesem Widget steht.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي عادة تظهر في هذا الـ Widget."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Widget-এ কোন অভ্যাস দেখাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which habit this Widget shows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué hábito aparece en este Widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle habitude apparaît dans ce Widget."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Widget में कौन-सी आदत दिखेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebiasaan mana yang tampil di Widget ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale abitudine compare in questo Widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このWidgetに表示する習慣です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Widget에 표시할 습관이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual hábito aparece neste Widget."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какая привычка показана в этом Widget."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Widget’ta hangi alışkanlığın görüneceği."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Widget میں کون سی عادت دکھے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget này hiển thị thói quen nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 Widget 显示哪个习惯。"
          }
        }
      }
    },
    "Welcher Habit über das Kontrollzentrum abgehakt wird.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي عادة يتم تسجيل إنجازها من مركز التحكّم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কন্ট্রোল সেন্টার থেকে কোন অভ্যাস সম্পন্ন করা হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which habit gets checked off from Control Center."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué hábito se marca desde el centro de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle habitude est cochée depuis le centre de contrôle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंट्रोल सेंटर से कौन-सी आदत पूरी की जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebiasaan mana yang dicentang lewat pusat kontrol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale abitudine viene spuntata dal centro di controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントロールセンターから完了にする習慣です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어 센터에서 체크할 습관이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual hábito é marcado pela central de controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какая привычка отмечается из пункта управления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol merkezinden hangi alışkanlığın işaretleneceği."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنٹرول سینٹر سے کون سی عادت مکمل کی جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thói quen nào được đánh dấu từ trung tâm điều khiển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从控制中心给哪个习惯打卡。"
          }
        }
      }
    },
    "Wenn heute wenig geht, geht heute eben wenig — und wird trotzdem eingetragen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان اليوم لا يتسع إلا للقليل، فليكن القليل — ويُسجَّل رغم ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ যদি অল্পই হয়, অল্পই হোক — তবু তা লেখা থাকবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If little is possible today, then little it is — and it still gets recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hoy da para poco, pues poco — y aun así queda registrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aujourd’hui ne permet que peu, ce sera peu — et ce sera quand même noté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आज कम ही हो पाता है, तो कम सही — दर्ज फिर भी होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau hari ini cuma bisa sedikit, ya sedikit — dan tetap dicatat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se oggi si può poco, allora poco — e va comunque registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は少ししかできないなら、少しでいい——それでもちゃんと記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 조금밖에 못 하겠다면 조금만 해도 돼요 — 그래도 기록은 남습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hoje só dá para pouco, então pouco — e mesmo assim fica registrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сегодня получается мало, значит мало — и это всё равно записывается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün az oluyorsa, az olsun — yine de kaydedilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آج کم ہی ہو سکے، تو کم سہی — درج پھر بھی ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu hôm nay chỉ làm được ít, thì ít vậy — và vẫn được ghi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天只能做一点，那就做一点——照样会记下来。"
          }
        }
      }
    },
    "Wer dranbleibt, sammelt Quadrate. Wer wartet, sammelt Pläne.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من يواظب يجمع مربعات. ومن ينتظر يجمع خططًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাঁরা লেগে থাকেন, তাঁরা ঘর জমান। যাঁরা অপেক্ষা করেন, তাঁরা পরিকল্পনা।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick with it and you collect squares. Wait and you collect plans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien sigue adelante junta cuadrados. Quien espera junta planes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui tient bon accumule des cases. Qui attend accumule des projets."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो डटे रहते हैं, वे वर्ग जमा करते हैं। जो इंतज़ार करते हैं, वे योजनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang konsisten mengumpulkan kotak. Yang menunggu mengumpulkan rencana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi tiene duro colleziona quadratini. Chi aspetta colleziona propositi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける人はマスを集めます。待つ人は計画を集めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꾸준히 하는 사람은 칸을 모으고, 기다리는 사람은 계획을 모읍니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem persiste junta quadradinhos. Quem espera junta planos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто не сдаётся, собирает квадратики. Кто ждёт, собирает планы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam eden kare biriktirir. Bekleyen plan biriktirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو قائم رہتے ہیں، وہ خانے جمع کرتے ہیں۔ جو انتظار کرتے ہیں، وہ منصوبے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai kiên trì thì gom được ô vuông. Ai chờ đợi thì gom được kế hoạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坚持的人攒格子，等待的人攒计划。"
          }
        }
      }
    },
    "Widgets neu geladen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إعادة تحميل الـ Widgets."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget আবার লোড হয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets reloaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets recargados."
          }
        },
        "fr": {

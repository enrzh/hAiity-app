    "Jeder Check-in ist ein Commit in deinem Repo — er füllt deinen echten Contribution-Graph.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تسجيل إنجاز هو Commit في الـ Repo الخاص بك — يملأ رسم المساهمات الحقيقي لديك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি চেক-ইন আপনার Repo-তে একটি Commit — এটি আপনার আসল কন্ট্রিবিউশন গ্রাফ পূরণ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every check-in is a commit in your repo — it fills your real contribution graph."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada check-in es un commit en tu repo — rellena tu gráfico de contribuciones de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque check-in est un commit dans ton repo — il remplit ton vrai graphique de contributions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर चेक-इन आपके Repo में एक Commit है — यह आपका असली कंट्रिब्यूशन ग्राफ़ भरता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap check-in adalah commit di repomu — mengisi contribution graph aslimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni check-in è un commit nel tuo repo — riempie il tuo vero grafico dei contributi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックインするたびにあなたのRepoにCommitが作られ、本物のコントリビューショングラフが埋まっていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크인 하나하나가 Repo의 Commit이 되어 진짜 컨트리뷰션 그래프를 채워요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada check-in é um commit no seu repo — ele preenche seu gráfico de contribuições de verdade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый чек-ин — это Commit в твоём Repo: он закрашивает твой настоящий график контрибуций."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her check-in, repondaki bir commit — gerçek katkı grafiğini dolduruyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر چیک اِن آپ کے Repo میں ایک Commit ہے — یہ آپ کا اصل کنٹریبیوشن گراف بھرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần check-in là một commit trong repo của bạn — nó lấp đầy biểu đồ đóng góp thật của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次打卡都是你 Repo 里的一个 Commit——它会填充你真实的贡献图。"
          }
        }
      }
    },
    "Kleiner Schritt, volle Zelle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوة صغيرة، خلية مكتملة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছোট পদক্ষেপ, ভরা ঘর।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small step, full square."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paso pequeño, una celda llena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit pas, case remplie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटा कदम, भरा हुआ वर्ग।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langkah kecil, satu kotak penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccolo passo, cella piena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな一歩で、マスがひとつ埋まる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 한 걸음, 채워지는 한 칸."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passo pequeno, célula cheia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленький шаг — целая клетка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük adım, dolu kare."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چھوٹا قدم، بھرا ہوا خانہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bước nhỏ, ô đầy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小小一步，点亮一格。"
          }
        }
      }
    },
    "Leg einen an und fang an, Quadrate zu füllen — jeder Tag, an dem du dranbleibst, färbt eine Zelle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ عادة وابدأ بملء المربعات — كل يوم تواظب فيه يلوّن خلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি তৈরি করুন আর ঘর ভরতে শুরু করুন — যেদিন আপনি লেগে থাকেন, সেদিন একটি ঘর রঙিন হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create one and start filling squares — every day you stick with it colors in a cell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea uno y empieza a llenar cuadrados — cada día que sigues adelante colorea una celda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crées-en une et commence à remplir des cases — chaque jour où tu tiens bon colore une case."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक आदत बनाएँ और वर्ग भरना शुरू करें — हर दिन जब आप डटे रहते हैं, एक वर्ग रंग जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat satu dan mulailah mengisi kotak — setiap hari kamu konsisten, satu kotak terwarnai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creane una e inizia a riempire quadratini — ogni giorno in cui tieni duro colora una cella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとつ作って、マスを埋めていきましょう——続けた日ごとにマスが色づきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 만들어서 칸을 채워 보세요 — 꾸준히 한 날마다 한 칸씩 색이 칠해져요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um e comece a preencher quadradinhos — cada dia em que você persiste colore uma célula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создай одну и начни заполнять квадратики — каждый день, когда ты не сдаёшься, закрашивает клетку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tane oluştur ve kareleri doldurmaya başla — devam ettiğin her gün bir kareyi boyar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بنائیں اور خانے بھرنا شروع کریں — جس دن آپ قائم رہتے ہیں، ایک خانہ رنگ جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo một thói quen và bắt đầu lấp đầy các ô vuông — mỗi ngày bạn kiên trì sẽ tô màu một ô."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一个，开始填格子——每坚持一天，就会点亮一格。"
          }
        }
      }
    },

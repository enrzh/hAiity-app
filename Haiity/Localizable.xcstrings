    "Endgültig löschen?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف نهائي؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চিরতরে মুছবেন?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete permanently?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar definitivamente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer définitivement ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमेशा के लिए हटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus permanen?"
          }
        },
        "it": {

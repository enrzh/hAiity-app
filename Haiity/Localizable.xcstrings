    "Eigene Farben? Das ist Pro.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألوان خاصة؟ هذا في Pro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজের রং? সেটা Pro-তে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom colors? That’s Pro."
          }
        },
        "es": {

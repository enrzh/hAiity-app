    "Alle Habits als ein Raster, dazu der Heute-Ring.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل العادات في شبكة واحدة، مع حلقة اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব অভ্যাস একটি গ্রিডে, সঙ্গে আজকের রিং।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All habits as one grid, plus the today ring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los hábitos en una cuadrícula, junto con el anillo de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les habitudes en une grille, avec l’anneau du jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी आदतें एक ग्रिड में, साथ में आज की रिंग।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua kebiasaan dalam satu kisi, plus cincin hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le abitudini in un’unica griglia, con l’anello di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全習慣をひとつのグリッドに、今日のリングも一緒に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 습관을 하나의 그리드로, 오늘 링과 함께."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os hábitos numa grade, junto com o anel de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все привычки в одной сетке, плюс кольцо сегодняшнего дня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm alışkanlıklar tek bir ızgarada, yanında bugün halkası."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام عادتیں ایک گرڈ میں، ساتھ آج کی رِنگ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả thói quen trong một lưới, kèm vòng hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有习惯合成一张格子图，外加今日圆环。"
          }
        }
      }
    },
    "Alle Habits geschafft!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنجزت كل العادات!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব হ্যাবিট শেষ!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All habits done!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Todos los hábitos hechos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les habitudes faites !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सारी आदतें पूरी!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua habit selesai!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le abitudini fatte!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全ハビット達成！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 해빗 완료!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os hábitos feitos!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все привычки выполнены!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm alışkanlıklar tamam!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب عادات مکمل!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong hết thói quen!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有习惯都完成了！"
          }
        }
      }
    },
    "Alle Habits von heute sitzen. Weiter so.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل عادات اليوم في مكانها. واصل هكذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের সব হ্যাবিট ঠিকঠাক। এভাবেই চালিয়ে যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All of today's habits are in. Keep going."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los hábitos de hoy están. Sigue así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les habitudes du jour sont en place. Continue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की सारी आदतें हो गईं। ऐसे ही चलते रहो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua habit hari ini beres. Lanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le abitudini di oggi ci sono. Continua così."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のハビットは全部OK。この調子で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 해빗 전부 완료. 계속 이렇게!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os hábitos de hoje estão feitos. Continue assim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все привычки на сегодня выполнены. Так держать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün tüm alışkanlıkları yerinde. Böyle devam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کی سب عادات ہو گئیں۔ اسی طرح جاری رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thói quen hôm nay đã đủ. Cứ thế phát huy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的习惯全部到位。继续保持。"
          }
        }
      }
    },
    "Alle Habits zusammen: heute %lld von %lld erledigt, Gesamt-Serie %lld Tage.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل العادات معًا: اليوم أُنجز %lld من %lld، والسلسلة الإجمالية %lld يومًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব অভ্যাস মিলিয়ে: আজ %2$lld-এর মধ্যে %1$lld সম্পন্ন, মোট স্ট্রিক %3$lld দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Alle Habits zusammen: heute %1$lld von %2$lld erledigt, Gesamt-Serie %3$lld Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All habits combined: %lld of %lld done today, total streak %lld days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los hábitos juntos: hoy %lld de %lld hechos, racha total de %lld días."
          }
        },

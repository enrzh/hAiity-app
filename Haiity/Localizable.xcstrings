    "Sagt, was heute erledigt ist und was noch offen steht.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بما أُنجز اليوم وما لا يزال مفتوحًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বলে আজ কী হয়েছে আর কী বাকি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you what's done today and what's still open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice qué está hecho hoy y qué queda pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit ce qui est fait aujourd'hui et ce qui reste ouvert."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताता है कि आज क्या हो गया और क्या बाकी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi tahu apa yang selesai hari ini dan apa yang masih terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice cosa è fatto oggi e cosa resta aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日終わったことと残っていることを教えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 끝난 것과 남은 것을 알려줍니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz o que está feito hoje e o que ainda falta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорит, что сегодня сделано и что ещё открыто."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün nelerin bittiğini ve nelerin açık kaldığını söyler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بتاتا ہے کہ آج کیا ہو گیا اور کیا باقی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho biết hôm nay đã xong gì và còn gì dang dở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉你今天完成了什么、还剩什么。"
          }
        }
      }
    },

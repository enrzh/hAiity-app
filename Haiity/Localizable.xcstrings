    "Apple nennt den Vornamen nur bei der allerersten Anmeldung. Kein Problem — trag einfach einen Alias ein.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشارك Apple الاسم إلا عند أول تسجيل دخول. لا مشكلة — أدخل اسمًا مستعارًا فحسب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple কেবল প্রথম সাইন-ইনে নাম দেয়। সমস্যা নেই — একটা ডাকনাম লিখলেই হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple only shares the first name on the very first sign-in. No problem — just enter an alias."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple solo da el nombre en el primer inicio de sesión. No pasa nada: escribe un alias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ne transmet le prénom qu'à la toute première connexion. Pas de souci — saisis simplement un alias."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple नाम केवल सबसे पहले साइन-इन पर देता है। कोई बात नहीं — बस एक उपनाम लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hanya memberi nama saat login pertama. Tak masalah — isi saja alias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple fornisce il nome solo al primissimo accesso. Nessun problema — inserisci un alias."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleが名前を渡すのは初回サインインのときだけ。大丈夫、ニックネームを入力すればOK。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple은 최초 로그인 때만 이름을 알려줍니다. 괜찮아요 — 별칭을 입력하면 됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple só informa o nome no primeiro login. Sem problema — basta digitar um apelido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple передаёт имя только при самом первом входе. Не беда — просто впиши псевдоним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple adı yalnızca ilk girişte paylaşır. Sorun değil — bir takma ad yaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple صرف پہلی بار سائن اِن پر نام دیتا ہے۔ کوئی بات نہیں — بس عرفی نام لکھ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple chỉ cung cấp tên ở lần đăng nhập đầu tiên. Không sao — cứ nhập biệt danh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 只在首次登录时提供名字。没关系——填个昵称就行。"
          }
        }
      }
    },

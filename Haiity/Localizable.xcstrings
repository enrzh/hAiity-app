    "Schön, dass du da bist": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سعيد بوجودك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে দেখে ভালো লাগল"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good to see you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me alegra verte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Content de te voir"
          }
        },
        "hi": {
          "stringUnit": {

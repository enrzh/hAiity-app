    "Endgültig löschen?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف نهائي؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চিরতরে মুছবেন?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete permanently?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar definitivamente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer définitivement ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमेशा के लिए हटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus permanen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare definitivamente?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전히 삭제할까요?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir permanentemente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить навсегда?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıcı olarak silinsin mi?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہمیشہ کے لیے حذف کریں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa vĩnh viễn?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "彻底删除？"
          }
        }
      }

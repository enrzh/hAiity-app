    "Beendet die laufende Habit-Session und hakt den Tag ab.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي جلسة العادة الجارية ويعلّم اليوم كمنجز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চলমান হ্যাবিট-সেশন শেষ করে দিনটিতে টিক দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends the running habit session and checks off the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la sesión de hábito en curso y marca el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine la session d’habitude en cours et coche la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चल रहे हैबिट-सेशन को समाप्त करता है और दिन पर सही का निशान लगाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengakhiri sesi kebiasaan yang berjalan dan mencentang hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la sessione di abitudine in corso e spunta la giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中の習慣セッションを終了し、今日をチェックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 습관 세션을 끝내고 오늘을 체크합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina a sessão de hábito em andamento e marca o dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает текущую сессию привычки и отмечает день."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süren alışkanlık seansını bitirir ve günü işaretler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاری ہیبٹ سیشن ختم کرتا ہے اور دن پر نشان لگاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết thúc phiên thói quen đang chạy và đánh dấu hoàn thành hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束正在进行的习惯计时，并勾选今天。"
          }
        }
      }
    },

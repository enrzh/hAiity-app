    "Abends in einem Satz: was erledigt ist und was noch offen steht.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المساء بجملة واحدة: ما أُنجز وما زال متبقيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সন্ধ্যায় এক বাক্যে: কী হয়ে গেছে আর কী বাকি আছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One sentence in the evening: what's done and what's still open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por la tarde, en una frase: qué está hecho y qué sigue pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir, en une phrase : ce qui est fait et ce qui reste à faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शाम को एक वाक्य में: क्या हो गया और क्या बाकी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam hari dalam satu kalimat: apa yang selesai dan apa yang masih terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sera, in una frase: cosa è fatto e cosa resta da fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜にひとこと：終わったことと、まだ残っていること。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저녁에 한 문장으로: 완료한 일과 아직 남은 일."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "À noite, em uma frase: o que está feito e o que ainda falta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечером одной фразой: что сделано и что ещё осталось."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşam tek cümleyle: neler bitti, neler hâlâ açık."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شام کو ایک جملے میں: کیا ہو گیا اور کیا باقی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buổi tối trong một câu: việc nào đã xong và việc nào còn dang dở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每晚一句话：哪些已完成，哪些还未完成。"
          }
        }
      }
    },
    "Abends und zum Wochenende — zwei kurze Hinweise, beide hier abwählbar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المساء ونهاية الأسبوع — تنبيهان قصيران، ويمكن إلغاء كليهما هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সন্ধ্যায় ও সপ্তাহের শেষে — দুটি ছোট বার্তা, দুটোই এখানে বন্ধ করা যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the evening and at the week's end — two short nudges, both optional here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por la noche y al final de la semana: dos avisos breves, ambos opcionales aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir et en fin de semaine — deux brefs rappels, tous deux désactivables ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शाम को और सप्ताह के अंत में — दो छोटी सूचनाएँ, दोनों यहाँ बंद की जा सकती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam hari dan akhir pekan — dua pengingat singkat, keduanya bisa dimatikan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sera e a fine settimana — due brevi avvisi, entrambi disattivabili qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜と週末に届く2つの短いお知らせ。どちらもここでオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저녁과 주말에 오는 두 개의 짧은 알림 — 둘 다 여기서 끌 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "À noite e no fim da semana — dois avisos curtos, ambos opcionais aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечером и в конце недели — две короткие подсказки, обе можно отключить здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşamları ve hafta sonunda — iki kısa bildirim, ikisi de burada kapatılabilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شام کو اور ہفتے کے آخر میں — دو مختصر اطلاعات، دونوں یہاں بند کی جا سکتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buổi tối và cuối tuần — hai nhắc nhở ngắn, đều có thể tắt tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晚间与周末的两条简短提示，均可在此关闭。"
          }
        }
      }
    },

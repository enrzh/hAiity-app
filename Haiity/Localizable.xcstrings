    "Ohne Eile": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على مهلك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাড়া নেই"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rush"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin prisa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans se presser"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई जल्दी नहीं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Santai saja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con calma"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急がずに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서두르지 않아도 돼요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem pressa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без спешки"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acelesi yok"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی جلدی نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không vội"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不急"
          }
        }
      }
    },
    "Ohne Startdatum gilt die Regel für die ganze Historie — so bleiben Quoten und Serien älterer Habits unverändert.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون تاريخ بدء تسري القاعدة على السجل كله — وهكذا تبقى نسب وسلاسل العادات القديمة كما هي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরুর তারিখ ছাড়া নিয়মটি পুরো ইতিহাসে প্রযোজ্য — এতে পুরোনো অভ্যাসের হার ও স্ট্রিক অপরিবর্তিত থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a start date the rule applies to the whole history — that keeps rates and streaks of older habits unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin fecha de inicio la regla se aplica a todo el historial, así las tasas y las rachas de los hábitos antiguos no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans date de début, la règle s’applique à tout l’historique — les taux et les séries des anciennes habitudes restent inchangés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आरंभ तिथि के बिना नियम पूरे इतिहास पर लागू होता है — इससे पुरानी आदतों की दरें और स्ट्रीक अपरिवर्तित रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa tanggal mulai, aturannya berlaku untuk seluruh riwayat — sehingga rasio dan streak kebiasaan lama tetap sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza data d’inizio la regola vale per tutta la cronologia: così percentuali e serie delle abitudini più vecchie restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始日を設定しない場合、ルールは履歴全体に適用されます。古い習慣の達成率や連続記録はそのまま保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작일이 없으면 규칙이 전체 기록에 적용돼요 — 그래서 예전 습관의 달성률과 연속 기록이 그대로 유지돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem data de início a regra vale para todo o histórico — assim as taxas e sequências dos hábitos antigos não mudam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без даты начала правило действует на всю историю — так проценты и серии старых привычек остаются прежними."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç tarihi olmadan kural tüm geçmiş için geçerlidir — böylece eski alışkanlıkların oranları ve serileri değişmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آغاز کی تاریخ کے بغیر قاعدہ پوری تاریخ پر لاگو ہوتا ہے — یوں پرانی عادات کی شرحیں اور سلسلے برقرار رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có ngày bắt đầu thì quy tắc áp dụng cho toàn bộ lịch sử — nhờ vậy tỷ lệ và chuỗi của các thói quen cũ không đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不设开始日期时，规则对整段历史生效——这样老习惯的完成率和连续记录都不会改变。"
          }
        }
      }
    },
    "Ohne gewählten Wochentag steht nie ein Termin an. Check-ins zählen trotzdem.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون اختيار يوم من الأسبوع لن يحين أي موعد أبدًا. تسجيلات الإنجاز تُحتسب على أي حال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো বার বেছে না নিলে কখনও কিছু নির্ধারিত হয় না। চেক-ইন তবুও গোনা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With no weekday selected nothing is ever due. Check-ins still count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no eliges ningún día de la semana, nunca toca nada. Los check-ins cuentan igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans jour de la semaine sélectionné, rien n’est jamais dû. Les check-ins comptent quand même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई वार चुने बिना कभी कुछ तय नहीं होता। चेक-इन फिर भी गिने जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa hari yang dipilih, tidak pernah ada jadwal. Check-in tetap dihitung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un giorno della settimana selezionato non scade mai nulla. I check-in contano lo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曜日を選ばないと予定は一度も入りません。チェックインはそれでもカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요일을 하나도 고르지 않으면 예정이 잡히지 않아요. 체크인은 그래도 집계돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem nenhum dia da semana escolhido, nunca vence nada. Os check-ins contam mesmo assim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если день недели не выбран, ничего никогда не запланировано. Чек-ины всё равно засчитываются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir gün seçilmezse hiçbir zaman bir şey gerekmez. Check-in’ler yine de sayılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی دن منتخب کیے بغیر کبھی کچھ مقرر نہیں ہوتا۔ چیک اِن پھر بھی شمار ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không chọn thứ nào thì sẽ không bao giờ có lịch. Các lần check-in vẫn được tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有选中任何星期几，就永远不会有安排。打卡照样计入。"
          }
        }
      }
    },
    "Perfekte Wochen sind selten. Brauchbare Wochen gibt es fast immer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسابيع المثالية نادرة. أما الأسابيع المقبولة فتكاد تكون دائمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিখুঁত সপ্তাহ বিরল। চলনসই সপ্তাহ প্রায় সবসময়ই থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfect weeks are rare. Workable weeks are almost always available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las semanas perfectas son raras. Las semanas aprovechables casi siempre las hay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les semaines parfaites sont rares. Les semaines correctes, il y en a presque toujours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेहतरीन हफ़्ते कम होते हैं। काम चलाऊ हफ़्ते लगभग हमेशा मिलते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minggu yang sempurna itu langka. Minggu yang lumayan hampir selalu ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le settimane perfette sono rare. Le settimane decenti ci sono quasi sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完璧な一週間はまれです。ほどほどの一週間なら、たいていあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완벽한 한 주는 드물어요. 그럭저럭 쓸 만한 한 주는 거의 늘 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Semanas perfeitas são raras. Semanas aproveitáveis existem quase sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идеальные недели редки. Сносные недели бывают почти всегда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusursuz haftalar nadirdir. İdare eden haftalar neredeyse hep vardır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بے عیب ہفتے کم ہوتے ہیں۔ کام چلاؤ ہفتے تقریباً ہمیشہ ملتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những tuần hoàn hảo thì hiếm. Những tuần tạm ổn thì hầu như lúc nào cũng có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完美的一周很少见。还过得去的一周，几乎总有。"
          }
        }
      }
    },
    "Pinsel wählen, Tage antippen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر فرشاة وانقر على الأيام"
          }

    "Deine Gesamt-Serie über alle Habits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سلسلتك الإجمالية عبر كل العادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব অভ্যাস মিলিয়ে তোমার মোট স্ট্রিক।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your total streak across all habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu racha total en todos los hábitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta série totale, toutes habitudes confondues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी आदतों में तुम्हारी कुल स्ट्रीक।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Total streak-mu di semua kebiasaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua serie totale su tutte le abitudini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全習慣を合わせた連続記録。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 습관을 합친 총 연속 기록."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sequência total em todos os hábitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя общая серия по всем привычкам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm alışkanlıklardaki toplam serin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام عادتوں میں تمہارا کل سلسلہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng chuỗi của bạn trên mọi thói quen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在所有习惯上的总连续天数。"
          }
        }
      }
    },
    "Deine Habits liegen auf diesem Gerät. Ist es bei iCloud angemeldet, spiegelt hAiity sie zusätzlich in deine private iCloud — nichts einzurichten, kein Konto bei uns, kein Server bei uns.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاداتك موجودة على هذا الجهاز. وإذا كان مسجّل الدخول إلى iCloud، فإن hAiity ينسخها أيضًا إلى iCloud الخاص بك — لا شيء لإعداده، ولا حساب لدينا، ولا خادم لدينا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অভ্যাস এই ডিভাইসেই থাকে। ডিভাইসটি iCloud-এ সাইন ইন করা থাকলে hAiity সেগুলো আপনার ব্যক্তিগত iCloud-এও মিরর করে — কিছু সেট আপ করার নেই, আমাদের এখানে কোনো অ্যাকাউন্ট নেই, কোনো সার্ভার নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your habits live on this device. If it is signed in to iCloud, hAiity also mirrors them into your private iCloud — nothing to set up, no account with us, no server of ours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus hábitos están en este dispositivo. Si tiene sesión iniciada en iCloud, hAiity también los refleja en tu iCloud privada: nada que configurar, sin cuenta con nosotros, sin servidor nuestro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes habitudes se trouvent sur cet appareil. S’il est connecté à iCloud, hAiity les recopie aussi dans ton iCloud privé — rien à configurer, aucun compte chez nous, aucun serveur chez nous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आदतें इसी डिवाइस पर रहती हैं। अगर यह iCloud में साइन इन है, तो hAiity उन्हें आपके निजी iCloud में भी मिरर करता है — कुछ सेट अप नहीं करना, हमारे यहाँ कोई अकाउंट नहीं, कोई सर्वर नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebiasaanmu ada di perangkat ini. Jika perangkatnya masuk ke iCloud, hAiity juga mencerminkannya ke iCloud pribadimu — tidak ada yang perlu diatur, tidak ada akun di kami, tidak ada server kami."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue abitudini stanno su questo dispositivo. Se è collegato a iCloud, hAiity le rispecchia anche nel tuo iCloud privato: niente da configurare, nessun account da noi, nessun server nostro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣はこのデバイスに保存されます。iCloudにサインインしていれば、hAiityはあなたのプライベートなiCloudにも同期します。設定は不要で、当方のアカウントもサーバーもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관은 이 기기에 저장돼요. 기기가 iCloud에 로그인돼 있으면 hAiity가 내 개인 iCloud에도 함께 저장해요. 설정할 것도 없고, 우리 쪽 계정도 서버도 없어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus hábitos ficam neste dispositivo. Se ele estiver conectado ao iCloud, o hAiity também os espelha no seu iCloud privado — nada para configurar, sem conta conosco, sem servidor nosso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои привычки лежат на этом устройстве. Если выполнен вход в iCloud, hAiity дополнительно отражает их в твоём личном iCloud — ничего настраивать не нужно, у нас нет ни аккаунта, ни сервера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlıkların bu cihazda durur. Cihaz iCloud’a giriş yapmışsa hAiity onları özel iCloud’una da yansıtır — kurulacak bir şey yok, bizde hesap yok, bizde sunucu yok."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی عادات اسی ڈیوائس پر رہتی ہیں۔ اگر یہ iCloud میں سائن اِن ہے تو hAiity انہیں آپ کے نجی iCloud میں بھی نقل کرتا ہے — کچھ سیٹ اپ نہیں کرنا، ہمارے ہاں کوئی اکاؤنٹ نہیں، کوئی سرور نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thói quen của bạn nằm trên thiết bị này. Nếu thiết bị đã đăng nhập iCloud, hAiity còn sao chép chúng vào iCloud riêng của bạn — không phải thiết lập gì, không có tài khoản ở chỗ chúng tôi, không có máy chủ của chúng tôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的习惯保存在这台设备上。如果设备已登录 iCloud，hAiity 还会把它们同步到你的私人 iCloud——无需设置，我们这边没有账号，也没有服务器。"
          }
        }
      }
    },
    "Deine Habits spiegeln sich über deine Apple-ID. Kein Konto, keine Anmeldung in der App.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنسخ عاداتك عبر Apple ID الخاص بك. لا حساب ولا تسجيل دخول داخل التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অভ্যাস আপনার Apple ID-র মাধ্যমে মিরর হয়। কোনো অ্যাকাউন্ট নেই, অ্যাপে সাইন ইন নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your habits mirror through your Apple ID. No account, no sign-in in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus hábitos se reflejan a través de tu Apple ID. Sin cuenta, sin iniciar sesión en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes habitudes se recopient via ton identifiant Apple. Aucun compte, aucune connexion dans l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आदतें आपकी Apple ID के ज़रिए मिरर होती हैं। कोई अकाउंट नहीं, ऐप में कोई साइन-इन नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebiasaanmu tercermin lewat Apple ID-mu. Tanpa akun, tanpa masuk di aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue abitudini si rispecchiano tramite il tuo Apple ID. Nessun account, nessun accesso nell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣はあなたのApple IDを通じて同期されます。アカウントもアプリ内のサインインも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관은 Apple ID를 통해 동기화돼요. 계정도, 앱 내 로그인도 없어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus hábitos são espelhados pelo seu Apple ID. Sem conta, sem login no app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои привычки отражаются через твой Apple ID. Ни аккаунта, ни входа в приложении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlıkların Apple ID’n üzerinden yansıtılır. Hesap yok, uygulamada oturum açma yok."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی عادات آپ کی Apple ID کے ذریعے نقل ہوتی ہیں۔ کوئی اکاؤنٹ نہیں، ایپ میں کوئی سائن اِن نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thói quen của bạn được sao chép qua Apple ID. Không tài khoản, không đăng nhập trong ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的习惯通过 Apple ID 同步。无需账号，也无需在 App 内登录。"
          }
        }
      }
    },
    "Der App Store hat gerade nicht geantwortet. Prüf deine Verbindung und versuch es noch einmal.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب App Store الآن. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store এইমাত্র সাড়া দেয়নি। আপনার সংযোগ দেখে নিয়ে আবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store didn’t respond just now. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no ha respondido ahora mismo. Comprueba tu conexión e inténtalo otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store n’a pas répondu à l’instant. Vérifie ta connexion et réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ने अभी जवाब नहीं दिया। अपना कनेक्शन जाँचें और दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store barusan tidak merespons. Periksa koneksimu dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store non ha risposto in questo momento. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeから応答がありませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store가 방금 응답하지 않았어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não respondeu agora. Verifique sua conexão e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store сейчас не ответил. Проверь соединение и попробуй ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store şu anda yanıt vermedi. Bağlantını kontrol edip yeniden dene."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store نے ابھی جواب نہیں دیا۔ اپنا کنکشن جانچیں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store vừa không phản hồi. Hãy kiểm tra kết nối và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 刚才没有响应。请检查网络连接后再试一次。"
          }
        }
      }
    },
    "Der Habit stellt eine Frage („Kein Zucker?“). Jeder Tag wird mit Ja oder Nein beantwortet — ein Nein ist etwas anderes als ein unbeantworteter Tag und bricht die Serie.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطرح العادة سؤالًا («بدون سكر؟»). يُجاب عن كل يوم بنعم أو لا — و«لا» ليست كاليوم بلا إجابة، فهي تقطع السلسلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অভ্যাসটি একটি প্রশ্ন করে (“চিনি নয়?”)। প্রতিটি দিনের উত্তর হ্যাঁ বা না — “না” উত্তরহীন দিনের মতো নয়, এটি স্ট্রিক ভেঙে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The habit asks a question (“No sugar?”). Every day is answered with Yes or No — a No is not the same as an unanswered day, and it breaks the streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hábito plantea una pregunta («¿Sin azúcar?»). Cada día se responde con Sí o No: un No no es lo mismo que un día sin responder y rompe la racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’habitude pose une question (« Pas de sucre ? »). Chaque journée reçoit une réponse Oui ou Non — un Non n’est pas la même chose qu’une journée sans réponse et il rompt la série."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आदत एक सवाल पूछती है (“कोई चीनी नहीं?”)। हर दिन का जवाब हाँ या नहीं में होता है — “नहीं” अनुत्तरित दिन से अलग है और स्ट्रीक तोड़ देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebiasaan ini mengajukan pertanyaan (“Tanpa gula?”). Setiap hari dijawab dengan Ya atau Tidak — sebuah Tidak berbeda dari hari yang belum dijawab dan memutus streak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abitudine pone una domanda («Niente zucchero?»). Ogni giorno riceve una risposta Sì o No: un No non è la stessa cosa di un giorno senza risposta e interrompe la serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣が質問を投げかけます（「砂糖なし？」）。毎日を「はい」か「いいえ」で答えます。「いいえ」は未回答の日とは別のもので、連続記録を途切れさせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관이 질문을 던집니다(“설탕 없이?”). 매일을 예 또는 아니요로 답합니다 — 아니요는 미응답인 날과 다르며 연속 기록을 끊습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O hábito faz uma pergunta (“Sem açúcar?”). Cada dia é respondido com Sim ou Não — um Não não é o mesmo que um dia sem resposta e quebra a sequência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привычка задаёт вопрос («Без сахара?»). На каждый день отвечают «Да» или «Нет» — «Нет» это не то же самое, что день без ответа, и оно прерывает серию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlık bir soru sorar (“Şekersiz mi?”). Her gün Evet ya da Hayır ile yanıtlanır — bir Hayır, yanıtlanmamış bir günle aynı şey değildir ve seriyi bozar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عادت ایک سوال پوچھتی ہے (”بغیر چینی؟“)۔ ہر دن کا جواب ہاں یا نہیں میں دیا جاتا ہے — ”نہیں“ بغیر جواب والے دن جیسا نہیں، یہ سلسلہ توڑ دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thói quen đặt một câu hỏi (“Không đường?”). Mỗi ngày được trả lời Có hoặc Không — một câu Không khác với một ngày chưa trả lời và nó làm đứt chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个习惯提出一个问题（“不吃糖？”）。每天用“是”或“否”回答——“否”与未回答的一天不同，会中断连续记录。"
          }
        }
      }
    },
    "Der Icon-Wechsel ist auf diesem Gerät gerade nicht möglich.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير الأيقونة غير ممكن على هذا الجهاز حاليًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে এখন আইকন বদলানো যাচ্ছে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the icon isn’t possible on this device right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el icono no es posible en este dispositivo ahora mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer l’icône n’est pas possible sur cet appareil pour le moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर अभी आइकन बदलना संभव नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengganti ikon sedang tidak bisa di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare l’icona al momento non è possibile su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは今アイコンを変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 지금 아이콘을 바꿀 수 없어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar o ícone não é possível neste aparelho agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сменить значок на этом устройстве сейчас нельзя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda şu an simge değiştirilemiyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس پر ابھی آئیکن بدلنا ممکن نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không thể đổi biểu tượng trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备暂时无法更换图标。"
          }
        }
      }
    },
    "Der Kalender-Zugriff ist in den iOS-Einstellungen deaktiviert. Dort erlauben, dann klappt der Kalender.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم معطّل في إعدادات iOS. اسمح به هناك وسيعمل التقويم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS সেটিংসে ক্যালেন্ডার অ্যাক্সেস বন্ধ আছে। সেখানে অনুমতি দিন, তাহলে ক্যালেন্ডার কাজ করবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is disabled in iOS Settings. Allow it there, and the calendar will work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al calendario está desactivado en Ajustes de iOS. Actívalo allí y el calendario funcionará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au calendrier est désactivé dans Réglages iOS. Autorise-le là-bas et le calendrier fonctionnera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्स में कैलेंडर एक्सेस बंद है। वहाँ अनुमति दें, फिर कैलेंडर काम करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalender dinonaktifkan di Pengaturan iOS. Izinkan di sana, maka kalender akan berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al calendario è disattivato nelle Impostazioni iOS. Consentilo lì e il calendario funzionerà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスがiOS設定で無効になっています。設定で許可すると使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정에서 캘린더 접근이 꺼져 있습니다. 설정에서 허용하면 캘린더가 작동합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário está desativado nos Ajustes do iOS. Permita lá e o calendário funcionará."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю отключён в настройках iOS. Разрешите его там, и календарь заработает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim erişimi iOS Ayarları'nda kapalı. Orada izin ver, takvim çalışacaktır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS سیٹنگز میں کیلنڈر تک رسائی غیر فعال ہے۔ وہاں اجازت دیں، پھر کیلنڈر کام کرے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập lịch bị tắt trong Cài đặt iOS. Cho phép ở đó thì lịch sẽ hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问已在 iOS 设置中停用。在设置中允许后即可使用。"
          }
        }
      }
    },
    "Der Zugriff auf Erinnerungen ist in den iOS-Einstellungen deaktiviert.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التذكيرات معطّل في إعدادات iOS."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS সেটিংসে রিমাইন্ডার অ্যাক্সেস বন্ধ আছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders access is disabled in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a los recordatorios está desactivado en Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès aux rappels est désactivé dans Réglages iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्स में रिमाइंडर एक्सेस बंद है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses pengingat dinonaktifkan di Pengaturan iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso ai promemoria è disattivato nelle Impostazioni iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS設定でリマインダーへのアクセスが無効になっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정에서 미리 알림 접근이 꺼져 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso aos lembretes está desativado nos Ajustes do iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к напоминаниям отключён в настройках iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anımsatıcı erişimi iOS Ayarları’nda kapalı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS سیٹنگز میں یاد دہانیوں تک رسائی غیر فعال ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập lời nhắc bị tắt trong Cài đặt iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒访问已在 iOS 设置中停用。"
          }
        }
      }
    },
    "Der Kauf ist nicht durchgegangen. Es wurde nichts berechnet — du kannst es gleich noch einmal versuchen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم عملية الشراء. لم يُخصم شيء — يمكنك المحاولة مجددًا على الفور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেনাটা সম্পন্ন হয়নি। কিছু চার্জ হয়নি — আপনি এখনই আবার চেষ্টা করতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase didn’t go through. Nothing was charged — you can try again right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra no se realizó. No se cobró nada — puedes intentarlo otra vez ahora mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’a pas abouti. Rien n’a été débité — tu peux réessayer tout de suite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ख़रीद पूरी नहीं हुई। कुछ भी शुल्क नहीं लिया गया — आप अभी दोबारा कोशिश कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian tidak berhasil. Tidak ada yang ditagih — kamu bisa langsung coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto non è andato a buon fine. Non è stato addebitato nulla — puoi riprovare subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は成立しませんでした。請求はありません — すぐにもう一度お試しいただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입이 이뤄지지 않았어요. 청구된 것은 없어요 — 바로 다시 시도해도 돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra não foi concluída. Nada foi cobrado — você pode tentar de novo agora mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка не прошла. Ничего не списано — можешь сразу попробовать ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma gerçekleşmedi. Hiçbir ücret alınmadı — hemen tekrar deneyebilirsin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خریداری مکمل نہیں ہو سکی۔ کچھ وصول نہیں کیا گیا — آپ ابھی دوبارہ کوشش کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch mua chưa thành công. Không có khoản nào bị tính — bạn có thể thử lại ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买没有完成。没有扣款——可以马上再试一次。"
          }
        }
      }
    },
    "Der Schalter dafür bleibt in Mehr — dort lässt sich das Schütteln jederzeit wieder einschalten.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى المفتاح في المزيد — يمكنك تشغيل الهز من هناك في أي وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুইচটি আরও-তে থাকে — সেখান থেকে ঝাঁকানো যেকোনো সময় আবার চালু করা যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The switch stays in More — you can turn shaking back on there at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El interruptor sigue en Más — allí puedes volver a activar el agitado cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage reste dans Plus — tu peux y réactiver le secouement à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्विच अधिक में रहता है — वहाँ से हिलाने की सुविधा कभी भी दोबारा चालू कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakelarnya tetap ada di Lainnya — kamu bisa menyalakannya lagi kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interruttore resta in Altro — lì puoi riattivare lo scuotimento quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチは「その他」に残ります。いつでもそこで振る操作を再びオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치는 더 보기에 남아 있어요. 언제든 거기서 흔들기를 다시 켤 수 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão continua em Mais — lá você pode reativar o sacudir quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключатель остаётся в разделе «Ещё» — там встряхивание можно снова включить в любой момент."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar Daha fazla bölümünde kalır — sallamayı istediğin zaman oradan yeniden açabilirsin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سوئچ مزید میں موجود رہتا ہے — وہاں سے ہلانے کی سہولت کبھی بھی دوبارہ آن کی جا سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc vẫn nằm trong Thêm — bạn có thể bật lại việc lắc bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开关仍在「更多」中——你随时可以在那里重新打开摇动。"
          }
        }
      }
    },
    "Der kopierte Text enthält keine Habit-Namen, keine Emojis und keine Werte — nur Zahlen, Zustände und technische Kennungen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص المنسوخ لا يحتوي على أسماء العادات ولا إيموجي ولا قيم — أرقام وحالات ومعرّفات تقنية فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কপি করা টেক্সটে অভ্যাসের নাম, ইমোজি বা মান থাকে না — শুধু সংখ্যা, অবস্থা আর কারিগরি শনাক্তকারী।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copied text contains no habit names, no emoji and no values — only numbers, states and technical identifiers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto copiado no contiene nombres de hábitos, ni emojis, ni valores — solo números, estados e identificadores técnicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte copié ne contient aucun nom d’habitude, aucun émoji et aucune valeur — seulement des nombres, des états et des identifiants techniques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी किए गए टेक्स्ट में आदतों के नाम, इमोजी और मान नहीं होते — सिर्फ़ संख्याएँ, स्थितियाँ और तकनीकी पहचानकर्ता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang disalin tidak memuat nama kebiasaan, emoji, atau nilai — hanya angka, status, dan penanda teknis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo copiato non contiene nomi di abitudini, né emoji, né valori — solo numeri, stati e identificatori tecnici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーされるテキストに習慣の名前、絵文字、記録の値は含まれません。数値と状態、技術的な識別子だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사된 텍스트에는 습관 이름도, 이모지도, 기록 값도 없어요 — 숫자와 상태, 기술적 식별자뿐이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto copiado não contém nomes de hábitos, nem emojis, nem valores — só números, estados e identificadores técnicos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированный текст не содержит названий привычек, эмодзи и значений — только числа, состояния и технические идентификаторы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalanan metinde alışkanlık adları, emojiler ve değerler yok — yalnızca sayılar, durumlar ve teknik kimlikler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاپی کیے گئے متن میں عادات کے نام، ایموجی یا اقدار نہیں ہوتیں — صرف اعداد، حالتیں اور تکنیکی شناختیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản đã sao chép không chứa tên thói quen, emoji hay giá trị — chỉ có số, trạng thái và định danh kỹ thuật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制的文本不含习惯名称、Emoji 和记录值——只有数字、状态和技术标识。"
          }
        }
      }
    },
    "Der mitgeschickte Text enthält keine Habit-Namen, keine Emojis und keine Werte — nur Zahlen, Zustände und technische Kennungen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص المُرسَل لا يحتوي على أسماء العادات ولا إيموجي ولا قيم — أرقام وحالات ومعرّفات تقنية فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাঠানো টেক্সটে অভ্যাসের নাম, ইমোজি বা মান থাকে না — শুধু সংখ্যা, অবস্থা আর কারিগরি শনাক্তকারী।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text that is sent contains no habit names, no emoji and no values — only numbers, states and technical identifiers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto enviado no contiene nombres de hábitos, ni emojis, ni valores — solo números, estados e identificadores técnicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte envoyé ne contient aucun nom d’habitude, aucun émoji et aucune valeur — seulement des nombres, des états et des identifiants techniques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजे जाने वाले टेक्स्ट में आदतों के नाम, इमोजी और मान नहीं होते — सिर्फ़ संख्याएँ, स्थितियाँ और तकनीकी पहचानकर्ता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang dikirim tidak memuat nama kebiasaan, emoji, atau nilai — hanya angka, status, dan penanda teknis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo inviato non contiene nomi di abitudini, né emoji, né valori — solo numeri, stati e identificatori tecnici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信されるテキストに習慣の名前、絵文字、記録の値は含まれません。数値と状態、技術的な識別子だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내는 텍스트에는 습관 이름도, 이모지도, 기록 값도 없어요 — 숫자와 상태, 기술적 식별자뿐이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto enviado não contém nomes de hábitos, nem emojis, nem valores — só números, estados e identificadores técnicos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляемый текст не содержит названий привычек, эмодзи и значений — только числа, состояния и технические идентификаторы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilen metinde alışkanlık adları, emojiler ve değerler yok — yalnızca sayılar, durumlar ve teknik kimlikler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بھیجے جانے والے متن میں عادات کے نام، ایموجی یا اقدار نہیں ہوتیں — صرف اعداد، حالتیں اور تکنیکی شناختیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản được gửi không chứa tên thói quen, emoji hay giá trị — chỉ có số, trạng thái và định danh kỹ thuật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送的文本不含习惯名称、Emoji 和记录值——只有数字、状态和技术标识。"
          }
        }
      }
    },
    "Der wievielte": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيّ واحد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনটি"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuál"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lequel"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन-सा"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang ke berapa"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何番目"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 번째"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой по счёту"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaçıncı"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کون سا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thứ mấy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第几个"
          }
        }
      }
    },
    "Diagnose kopieren": {
      "localizations": {
        "ar": {
          "stringUnit": {

          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভালো হতে হবে না। শুধু হলেই হলো।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It does not have to be good. It only has to happen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tiene que salir bien. Solo tiene que ocurrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça n’a pas besoin d’être réussi. Ça a juste besoin d’avoir lieu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अच्छा होना ज़रूरी नहीं। बस हो जाना ज़रूरी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak harus bagus. Cukup terjadi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non deve venire bene. Deve solo avvenire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくやる必要はありません。やりさえすればいいのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘할 필요는 없어요. 그냥 하기만 하면 됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não precisa ficar bom. Só precisa acontecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не обязательно хорошо. Достаточно, чтобы это просто произошло."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyi olması gerekmiyor. Sadece olması yeter."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اچھا ہونا ضروری نہیں۔ بس ہو جانا کافی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần phải hay. Chỉ cần nó diễn ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不必做得好。做了就行。"
          }
        }
      }
    },

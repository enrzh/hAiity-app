    "Mehrere Habits als Zeilen — was heute ansteht, auf einen Blick.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدة عادات في صفوف — ما يحين اليوم بنظرة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একাধিক অভ্যাস সারি হিসেবে — আজ কী আছে, এক নজরে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several habits as rows — what’s due today at a glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varios hábitos en filas: lo de hoy de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs habitudes en lignes — ce qui est dû aujourd’hui d’un coup d’œil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई आदतें पंक्तियों में — आज क्या करना है, एक नज़र में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa kebiasaan sebagai baris — apa yang jatuh tempo hari ini, sekilas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più abitudini in righe: quello che c’è oggi a colpo d’occhio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の習慣を行で表示。今日やることがひと目でわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 습관을 줄로 — 오늘 할 일을 한눈에."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vários hábitos em linhas — o de hoje num relance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько привычек строками — что запланировано на сегодня, одним взглядом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır satır birkaç alışkanlık — bugün ne var, bir bakışta."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کئی عادات قطاروں میں — آج کیا کرنا ہے، ایک نظر میں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiều thói quen theo hàng — hôm nay có gì, chỉ một cái nhìn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个习惯排成行——今天该做什么，一眼看清。"
          }
        }
      }
    },
    "Mehrere Tage nachtragen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل عدة أيام سابقة"
          }
        },
        "bn": {

    "Unbegrenzte Habits, eigene Farben, Kalender und volle Statistik.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادات بلا حدود، وألوان خاصة، وتقويم، وإحصاءات كاملة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমাহীন অভ্যাস, নিজের রং, ক্যালেন্ডার আর পূর্ণ পরিসংখ্যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited habits, custom colors, calendar and full stats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hábitos ilimitados, colores propios, calendario y estadísticas completas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Habitudes illimitées, couleurs personnalisées, calendrier et statistiques complètes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असीमित आदतें, अपने रंग, कैलेंडर और पूरे आँकड़े।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebiasaan tanpa batas, warna sendiri, kalender, dan statistik lengkap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abitudini illimitate, colori personalizzati, calendario e statistiche complete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無制限の習慣、独自の色、カレンダー、そして統計のすべて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무제한 습관, 직접 만든 색, 캘린더, 통계 전체."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hábitos ilimitados, cores próprias, calendário e estatísticas completas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привычки без ограничений, свои цвета, календарь и полная статистика."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırsız alışkanlık, kendi renklerin, takvim ve tüm istatistikler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لامحدود عادات، اپنے رنگ، کیلنڈر اور مکمل اعداد و شمار۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thói quen không giới hạn, màu riêng, lịch và thống kê đầy đủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无限习惯、自定义颜色、日历，以及完整统计。"
          }
        }
      }
    },

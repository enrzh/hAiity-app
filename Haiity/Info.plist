<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.aiity.haiity.github-refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleDisplayName</key>
	<string>hAiity</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
		<string>es</string>
		<string>fr</string>
		<string>pt</string>
		<string>it</string>
		<string>zh-Hans</string>
		<string>ja</string>
		<string>ru</string>
		<string>ar</string>
		<string>hi</string>
		<string>bn</string>
		<string>ur</string>
		<string>id</string>
		<string>tr</string>
		<string>vi</string>
		<string>ko</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.aiity.haiity</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>haiity</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>GitHubClientID</key>
	<string>$(GITHUB_CLIENT_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>hAiity legt einen eigenen Kalender an und pflegt darin die Termine deiner Habits. Deine übrigen Kalender und Termine bleiben unberührt.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>hAiity hört nur zu, während du den Satz aufnimmst, aus dem ein neues Habit entstehen soll. Die Aufnahme startet nur, wenn du den Knopf drückst, und endet, sobald du ihn erneut drückst.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>hAiity synchronisiert deine eigenen Erinnerungen mit der Apple Erinnerungen-App.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>hAiity schreibt deinen aufgenommenen Satz in Text um, damit daraus ein Habit oder eine Erinnerung wird. Die Aufnahme endet, sobald du den Knopf erneut drückst.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchTiles</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>

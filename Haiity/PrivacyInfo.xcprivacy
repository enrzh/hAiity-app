<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  hAiity sammelt nichts und trackt nicht. Habit-Daten liegen in der
	  App-Group-Datei data.json auf dem Gerät; der iCloud-Spiegel schreibt
	  ausschliesslich in die PRIVATE CloudKit-Datenbank der Apple-ID des
	  Nutzers, nicht an uns. Die optionale GitHub-Verbindung spricht
	  github.com und api.github.com direkt an; Token und Cache bleiben auf
	  diesem Gerät. Es gibt kein GitHub-SDK.

	  Diese Datei landet in BEIDEN Bundles (App und Widget-Extension) —
	  Apple prueft jedes Bundle einzeln (ITMS-91053).
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
			  HabitStore.signature() liest die modificationDate von data.json im
			  App-Group-Container, um nach einem Widget-Schreibvorgang neu zu
			  laden. Nur der eigene Container, kein fremder Pfad.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- Eigene Einstellungen und geteilte App-Group-Defaults fuer App und Widget. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
		<dict>
			<!-- LocalModelService verweigert den Download, wenn der Platz fuer die Modelldateien fehlt. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
